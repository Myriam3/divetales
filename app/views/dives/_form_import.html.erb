<% if @trip %>
  <div class="container mt-4">
    <h2 class="mb-3">1. Import your dive log</h2>

    <div class="mb-3">
      <div class="mb-3">
        <label for="fit_file">FIT file (.fit)</label>
        <%= file_field_tag :fit_file,
          accept: ".fit",
          class: "form-control-file",
          data: {
            dive_data_import_target: "fileInput"
          } %>
      </div>
      <button
        type="button"
        class="btn btn-secondary mt-3"
        data-action="click->dive-data-import#importFile"
        data-dive-data-import-target="submitButton"
      >
        <%= render "shared/icon", icon_name: "device-watch-stats" %>
        Import file
      </button>

      <p class="mt-3" data-dive-data-import-target="feedback"></p>
      <pre class="mt-3" data-dive-data-import-target="result"></pre>
    </div>

    <div class="mb-5">
      <h3 class="h5">
        <%= render "shared/icon", icon_name: "info-circle" %>
        Supported format
      </h3>
      <p class="mb-2">
        <small>
          Currently supported: FIT format (Garmin, Suunto, ...), meters (depth), °C (temperature) units.
        </small>
      </p>
      <p class="mb-0">Export your dive log as a <strong>FIT file</strong> from your dive app or dive computer.</p>
      <p class="mb-0">If you do not use a compatible dive computer, you can also input your data manually below.</p>

    </div>
  </div>
<% end %>
