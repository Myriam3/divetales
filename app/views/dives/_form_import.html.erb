<% if @trip %>
  <section class="new-dive-panel">
    <div class="new-dive-panel-heading">
      <h2><span class="new-dive-step">1</span> Import your dive log</h2>
      <span class="new-dive-optional">Optional</span>
    </div>

    <p>Have a log from your dive computer? Import it here, or fill in the details below.</p>

    <div class="new-dive-import">
      <div>
        <label for="fit_file" class="form-label">FIT file (.fit)</label>
        <%= file_field_tag :fit_file,
          accept: ".fit",
          class: "form-control",
          data: { dive_data_import_target: "fileInput" } %>
      </div>

      <button type="button"
        class="btn-dive btn-dive-primary"
        data-action="click->dive-data-import#importFile"
        data-dive-data-import-target="submitButton">
        <%= render "shared/icon", icon_name: "device-watch-stats" %>
        Import file
      </button>
    </div>

    <p class="new-dive-feedback" data-dive-data-import-target="feedback"></p>
    <pre data-dive-data-import-target="result"></pre>

    <div class="new-dive-import-help">
      <h3>
        <%= render "shared/icon", icon_name: "info-circle" %>
        Supported format
      </h3>
      <p>FIT files from Garmin, Suunto and other compatible dive computers. Depth in meters and temperature in °C.</p>
      <p>Export your dive log as a FIT file from your dive app or dive computer.</p>
    </div>
  </section>
<% end %>
