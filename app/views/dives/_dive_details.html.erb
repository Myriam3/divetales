<div class="dive-page__container">
  <div class="dive-page__panel">
  <section id="species" class="dive-page__species">
    <div class="dive-page__species-top">
      <h2>
        <%= render "shared/icon", icon_name: "fish", icon_size: 36 %>
        Encountered marine life
      </h2>

      <p class="dive-page__species-btn">
        <%= link_to identification_path(dive_id: @dive.id), class: "btn btn-dive btn-dive-accent" do %>
        <%= render "shared/icon", icon_name: "photo-spark" %>
          Identify a new species
        <% end %>
      </p>
    </div>

    <% if @species.any? %>
      <ul class="dive-page__species-list list-unstyled">
        <% @species.first(20).sort_by(&:name).each do |species| %>
          <li>
            <%= render "shared/species_card", species: species %>
          </li>
        <% end %>
      </ul>
      <% if @species.count > 20 %>
        <p class="text-center">
          <%= link_to pictures_path, class: "btn btn-dive btn-dive-primary" do %>
          <%= render "shared/icon", icon_name: "camera-spark" %>
            See all identified species
          <% end %>
        </p>
      <% end %>
    <% else %>
      <p>No species identified for this dive.</p>
    <% end %>
  </section>
  </div>
</div>

<section id="pictures" class="mt-5" data-turbo-preserve-scroll>
  <div class="dive-page__container">
    <div class="dive-page__pictures-top">
      <h2 class="mb-4">
        <%= render "shared/icon", icon_name: "library-photo", icon_size: 36 %>
        Dive pictures
      </h2>

      <p class="dive-page__pictures-btn">
        <%= link_to new_picture_path(dive_id: @dive.id, trip_id: @dive.trip_id), class: "btn btn-dive btn-dive-accent" do %>
        <%= render "shared/icon", icon_name: "camera-spark" %>
          Add a new picture
        <% end %>
      </p>
    </div>
  </div>

  <% if @dive.pictures.any? %>
  <div class="container-fluid">
    <div class="dive-page__pictures-list">
      <%= render "dive_slider", pictures: @dive.pictures.first(20) %>
    </div>
    <% if @dive.pictures.count > 20 %>
        <p class="text-center mt-5">
          <%= link_to pictures_path, class: "btn btn-dive btn-dive-primary" do %>
          <%= render "shared/icon", icon_name: "camera-spark" %>
            See all pictures
          <% end %>
        </p>
      <% end %>
  </div>
  <% else %>
    <div class="dive-page__container">
      <p>No pictures for this dive.</p>
    </div>
  <% end %>
</section>
