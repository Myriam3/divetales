<% if dive.depth_over_time.present? %>
  <h2 class="mt-5 mb-5">
    <%= render "shared/icon", icon_name: "scuba-diving", icon_size: 40 %>
    Depth profile
  </h2>
  <div class="mb-5"
      data-controller="depth-chart"
      data-depth-chart-data-value="<%= html_escape(dive.depth_over_time) %>">
      <canvas data-depth-chart-target="canvas"
              height="400"
      ></canvas>
  </div>
<% end %>
