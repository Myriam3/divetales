<% if @dive %>
  <div class="mt-5 mb-2 text-end">
    <%= render "new_dive_trip_select", other_trips: @other_trips, current_trip: @dive.trip %>
  </div>

  <div class="mb-2">
    <%= link_to trip_path(@dive.trip), class: "text-decoration-none" do %>
      <%= render "shared/icon", icon_name: "arrow-left" %>
      <%= @dive.trip.title %>
    <% end %>
  </div>

  <div class="mb-5">
  <%= link_to dives_path, class: "text-decoration-none" do %>
    <%= render "shared/icon", icon_name: "arrow-left" %>
    All dives
  <% end %>
</div>

  <h1 class="mb-4"><%= render "shared/icon", icon_name: "scuba-mask", icon_size: 40 %><%= @dive.display_name_html %></h1>

  <p class="text-end mb-4">
    <%= link_to "#", class: "btn btn-outline-secondary" do %>
      <%= render "shared/icon", icon_name: "edit" %>
      Edit dive
  <% end %>
  </p>


  <%= render "shared/dive", dive: @dive %>

  <%= render "depth_profile", dive: @dive %>
<% end %>

  <p class="mt-5 mb-5">
    <%= button_to dive_path(@dive),
                method: :delete,
                class: "btn btn-outline-secondary",
                data: {
                  turbo_confirm: "Are you sure? This will delete also the dive pictures and identified species."
                } do %>
      <%= render "shared/icon", icon_name: "trash", icon_size: 24 %>
      Delete dive
    <% end %>
</p>
