<% if @dive %>
  <%
    dive_title = @dive.dive_site_name.blank? ? @dive.location.name : @dive.dive_site_name
    dive_title += ", #{@dive.date}"
  %>

  <h1><%= render "shared/icon", icon_name: "scuba-mask", icon_size: 40 %><%= dive_title %></h1>

  <%= render "shared/dive", dive: @dive %>
<% end %>

<hr>

<%= link_to dives_path do %>
  <%= render "shared/icon", icon_name: "arrow-left" %>
  All dives
<% end %>
