
<%= simple_form_for [@trip, @dive],
    data: { dive_data_import_target: "diveForm", controller: "autocomplete-divesite", autocomplete_divesite_url_value: "/dive_sites", action: "click@window->autocomplete-divesite#hide" } do |f| %>

  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <%= f.input :depth_over_time, as: :hidden %>

  <% if @dive.errors.any? %>
    <div class="alert alert-danger">
      <p><%= pluralize(@dive.errors.count, "error") %> prevented this dive from being saved:</p>
      <ul>
        <% @dive.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="new-dive-panel">
    <h2><span class="new-dive-step">2</span> Complete your dive details</h2>

    <div class="row">
      <div class="col-md-6">
        <%= f.input :dive_number,
          label: "Dive number",
          input_html: { min: 1, step: 1 } %>
      </div>
      <div class="col-md-6">
        <%= f.input :date,
          label: "Date of the dive",
          as: :date,
          html5: true,
          required: true %>
      </div>
    </div>

      <h3>
      <%= render "shared/icon", icon_name: "world-pin", icon_size: 24 %>
      Location
    </h3>

    <div class="row">
      <div class="col-md-6">
        <% if @trip_countries %>
          <%= f.label :location_id,
            'Dive location <abbr title="required">*</abbr>'.html_safe,
            class: "form-label string required" %>

          <%= f.select :location_id,
            grouped_options_for_select(
              @trip_countries.map do |country|
                [
                  country.name,
                  country.locations.map { |location| [location.name, location.id] },
                  { data: { country_code: country.code } }
                ]
              end
            ),
            {
              label: "Dive location",
              prompt: "Select a location",
              required: true
            },
            {
              class: "form-select select required #{'is-invalid' if @dive.errors[:location].any?}",
              data: { autocomplete_divesite_target: "location" }
            } %>
        <% else %>
          <%= f.input :location_id,
            label: "Dive location",
            collection: Location.all.order(:name),
            label_method: :name,
            value_method: :id,
            prompt: "Select a location",
            required: true,
            input_html: {
              class: "#{'is-invalid' if @dive.errors[:location].any?}",
              data: { autocomplete_divesite_target: "location" }
            } %>
        <% end %>
      </div>

      <div class="col-md-6">
        <div class="position-relative">
          <%= f.input :dive_site_name,
            label: "Dive site",
            placeholder: "Name of the dive site",
            required: true,
            input_html: {
              autocomplete: "off",
              data: {
                autocomplete_divesite_target: "input",
                action: "input->autocomplete-divesite#search focus->autocomplete-divesite#search click->autocomplete-divesite#search"
              }
            } %>
          <div class="new-dive-suggestions list-group position-absolute w-100 shadow-sm d-none z-3"
            data-autocomplete-divesite-target="results"></div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <%= f.input :latitude,
          label: "Latitude",
          input_html: { step: 0.000001, data: { autocomplete_divesite_target: "latitude" } } %>
      </div>
      <div class="col-md-6">
        <%= f.input :longitude,
          label: "Longitude",
          input_html: { step: 0.000001, data: { autocomplete_divesite_target: "longitude" } } %>
      </div>
    </div>

    <h3>
      <%= render "shared/icon", icon_name: "scuba-diving", icon_size: 24 %>
      Dive types
    </h3>
    <%= f.input :dive_types,
      label: "Select type(s)",
      collection: Dive::DIVE_TYPES,
      as: :check_boxes,
      item_wrapper_class: "form-check-inline",
      label_method: ->(type) { type.humanize },
      include_hidden: false %>
  </section>

  <div class="new-dive-details">
    <section class="new-dive-panel">
      <h2>
        <%= render "shared/icon", icon_name: "device-watch-stats", icon_size: 26 %>
        Time & air
      </h2>

      <%= f.input :duration,
        label: "Duration (minutes)",
        input_html: { min: 1, step: 1 } %>

      <%= f.input :start_time, label: "Start time", as: :datetime, html5: true %>
      <%= f.input :end_time, label: "End time", as: :datetime, html5: true %>

      <h3>
        <%= render "shared/icon", icon_name: "scuba-diving-tank", icon_size: 24 %>
        Air
      </h3>
      <div class="row">
        <div class="col-sm-6">
          <%= f.input :gauge_pressure_start, label: "Pressure start (bar)" %>
        </div>
        <div class="col-sm-6">
          <%= f.input :gauge_pressure_end, label: "Pressure end (bar)" %>
        </div>
      </div>
      <%= f.input :tank_type,
        label: "Tank type",
        collection: Dive.tank_types.keys.map { |key| [key.humanize, key] } %>
    </section>

    <section class="new-dive-panel">
      <h2>
        <%= render "shared/icon", icon_name: "arrow-bar-to-down", icon_size: 26 %>
        Depth & temperature
      </h2>

      <div class="row">
        <div class="col-sm-6">
          <%= f.input :max_depth,
            label: "Maximum depth (m)",
            input_html: { min: 0, step: 0.1 } %>
        </div>
        <div class="col-sm-6">
          <%= f.input :avg_depth,
            label: "Average depth (m)",
            input_html: { min: 0, step: 0.1 } %>
        </div>
      </div>

      <h3>
        <%= render "shared/icon", icon_name: "temperature", icon_size: 24 %>
        Temperature
      </h3>
      <%= f.input :max_temp,
        label: "Maximum temperature (°C)",
        input_html: { step: 0.1 } %>
      <%= f.input :min_temp,
        label: "Minimum temperature (°C)",
        input_html: { step: 0.1 } %>
      <%= f.input :avg_temp,
        label: "Average temperature (°C)",
        input_html: { step: 0.1 } %>
    </section>
  </div>

  <section class="new-dive-panel">
    <h2>
      <%= render "shared/icon", icon_name: "notebook", icon_size: 26 %>
      Memo
    </h2>
    <%= f.input :note,
      label: "What do you want to remember about this dive?",
      as: :text,
      input_html: { rows: 5 } %>
  </section>

  <div class="new-dive-actions">
    <%= link_to "Cancel", @trip, class: "btn-dive btn-dive-secondary" %>
    <%= f.button :submit, "Add dive", class: "btn-dive btn-dive-primary" %>
  </div>
<% end %>
