<h1 class="mt-5 mb-4">Add a new dive</h1>

<% if @trip %>
  <p class="mt-3 mb-4 fs-3">
      <%= render "shared/icon", icon_name: "luggage", icon_size: 36, label: "Trip:" %>
      <%= @trip.title %>

    <% @trip.countries.each do |country| %>
      <span>
        <%= icon country.code.downcase, library: "flags", width: 20, height: 20 %>
        <span class="visually-hidden"><%= country.name %></span>
      </span>
    <% end %>
  </p>

  <% if @other_trips && @other_trips.length > 1 %>
    <div class="mt-4 mb-5">
      <%= render "new_dive_trip_select",
                  other_trips: @other_trips,
                  label: "Select another trip?",
                  icon: 'none',
                  button_style: 'btn-outline-secondary btn-sm' %>
    </div>
  <% end %>

  <%= render "form" %>

  <div id="modal-container"></div>
<% end %>
