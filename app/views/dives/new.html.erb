<h1 class="mt-5 mb-4">Add a new dive</h1>

<% if @trip %>
  <p class="mt-3 mb-5 fs-3">

      <%= render "shared/icon", icon_name: "luggage", icon_size: 36, label: "Trip:" %>
      <%= @trip.title %>

    <% @trip.countries.each do |country| %>
      <span>
        <%= icon country.code.downcase, library: "flags", width: 20, height: 20 %>
        <span class="visually-hidden"><%= country.name %></span>
      </span>
    <% end %>
  </p>

  <%= render "form" %>

  <div id="modal-container"></div>
<% else %>
  Select a dive (in progress)
<% end %>

<%= form_with url: bulk_create_pictures_path, method: :post, local: true do %>
  <%= hidden_field_tag "pictures_bulk[dive_id]", @selected_dive_id %>
  <%= file_field_tag "pictures_bulk[photos][]", multiple: true %>
  <%= submit_tag "Upload 5 Photos" %>
<% end %>
