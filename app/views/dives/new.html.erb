<% content_for :meta_title, "Log a New Dive | Dive Tales" %>
<% content_for :meta_description, "Record a new scuba dive entry. Add your dive site, bottom time, depth, and underwater sightings to your digital logbook." %>

<% if @trip %>
  <section class="new-dive-page">
    <div class="new-dive-hero">
      <h1>
        <%= render "shared/icon", icon_name: "scuba-mask", icon_size: 38 %>
        Add a new dive
      </h1>
      <p>Save the details of your next underwater story.</p>
    </div>
    <div class="new-dive-content">
      <div class="new-dive-trip">
        <div>
          <h2>
            <%= render "shared/icon", icon_name: "luggage", icon_size: 28, label: "Trip:" %>
            <%= @trip.title %>
          </h2>
          <p class="new-dive-trip__countries">
            Trip countries:
            <% @trip.countries.each do |country| %>
              <span title="<%= country.name %>">
                <%= icon country.code.downcase, library: "flags", width: 20, height: 20 %>
                <span class="visually-hidden"><%= country.name %></span>
              </span>
            <% end %>
          </p>
        </div>

          <% if @other_trips && @other_trips.length > 1 %>
            <%= render "new_dive_trip_select",
              other_trips: @other_trips,
              label: "Select another trip?",
              icon: "none",
              button_style: "btn-dive btn-dive-secondary" %>
          <% end %>
        </div>

        <%= render "form" %>

        <div id="modal-container"></div>
    </div>
  </section>
<% end %>
