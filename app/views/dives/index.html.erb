<%
  select_trip_list = @trip ? @other_trips : @last_trips
%>

<% if @trip %>
  <h1 class="mt-5 mb-3">
    Dives logged in <%= @trip.title %>
  </h1>

  <%= link_to trip_path(@trip), class: "text-decoration-none" do %>
    <%= render "shared/icon", icon_name: "arrow-left" %>
    <%= @trip.title %>
  <% end %>

  <p>
    <%= link_to dives_path, class: "text-decoration-none" do %>
      <%= render "shared/icon", icon_name: "arrow-left" %>
      All dives
    <% end %>
  </p>
<% else %>
  <h1 class="mt-5 mb-3">
    All my dives
  </h1>
<% end %>

<% if select_trip_list && select_trip_list.length > 1 %>
  <div class="mt-4 mb-5 text-end">
    <%= render "new_dive_trip_select",
        other_trips: select_trip_list,
        current_trip: @trip
    %>
  </div>
<% end %>

<p>
  <%= render "shared/icon", icon_name: "scuba-mask" %>
  <%= pluralize(@dives.count, "dive") %>
</p>

<p>
  <%= render "shared/icon", icon_name: "world-map" %>
  <%= @countries_count %>
  <%= "country".pluralize(@countries_count) %>
</p>

<p>
  <%= render "shared/icon", icon_name: "camera-spark" %>
  <%= @pictures_count %>
  <%= "picture".pluralize(@pictures_count) %>
</p>

<p>
  <%= render "shared/icon", icon_name: "fish" %>
  <%= @species_count %>
  <%= "species" %> identified
</p>

<% if @dives.any? %>
  <ul class="list-unstyled mt-5">
    <% @dives.each_with_index do |dive, index| %>
    <li class="mt-3"><%= render "shared/dive_card", dive: dive %></li>
  <% end %>
  </ul>
<% end %>
