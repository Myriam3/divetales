<dialog id="lightbox"
        data-lightbox-target="dialog"
        class="lightbox"
        style="display: none;">
  <div class="lightbox__content" data-lightbox-target="content">
    <button type="submit" aria-label="Close" class="btn btn-link lightbox__close" data-action="click->lightbox#close">
      <%= render "shared/icon", icon_name: "x", icon_size: 24 %>
    </button>

    <div class="lightbox__inner">
      <div id="lightbox-content"></div>
    </div>
  </div>
</dialog>
