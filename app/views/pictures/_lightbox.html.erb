<dialog id="lightbox"
        data-lightbox-target="dialog"
        class="lightbox"
        style="display: none;">
  <div class="lightbox__content" data-lightbox-target="content">
    <button type="submit" aria-label="Close" data-action="click->lightbox#close">
      Close
    </button>

    <div class="lightbox__inner">
      <div id="lightbox-content"></div>
    </div>
  </div>
</dialog>

<style>
  .lightbox {
    display: block;
    overflow: hidden;
    border: 0;
    background: transparent;
  }

  .lightbox::backdrop {
    background-color: rgba(0, 0, 0, 0.8);
  }

  .lightbox__content {
    visibility: hidden;
    opacity: 0;
    width: min(90%, 1000px);
    margin: 0 auto;
    transition: opacity .25s, visibility .25s;
    color: #fff;
  }

  .lightbox[open] .lightbox__content.visible {
    visibility: visible;
    opacity: 1;
    transition: 'none';
  }

  .lightbox__inner {
    height: 100%;
  }

  .lightbox .splide__slide .pic-slide {
    height: 80vh;
    overflow: hidden;
    width: 100%;
  }

  .lightbox .splide__slide .pic-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
