<dialog id="lightbox"
        data-lightbox-target="dialog"
        class="lightbox"
        style="display: none;">
  <div class="lightbox__content" data-lightbox-target="content">
    <button type="submit" aria-label="Close" data-action="click->lightbox#close">
      Close
    </button>

    <div class="lightbox__inner">
      <div id="lightbox-content"></div>
    </div>
  </div>
</dialog>

<style>
  .lightbox {
    display: block;
    overflow: hidden;
    border: 0;
    background: transparent;
    padding: 0;
  }

  .lightbox::backdrop {
    background-color: rgba(0, 0, 0, 0.95);
  }

  .lightbox__content {
    visibility: hidden;
    opacity: 0;
    width: min(90%, 1000px);
    margin: 0 auto;
    transition: opacity .25s, visibility .25s;
    color: #fff;
  }

  .lightbox[open] .lightbox__content.visible {
    visibility: visible;
    opacity: 1;
    transition: 'none';
  }

  .lightbox__inner {
    height: 100%;
  }

  .lightbox .splide__slide .pic-slide {
    height: 70vh;
    /* overflow: hidden; */
    width: 100%;
  }

  .lightbox .splide__slide .pic-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top;
  }

  .ligthbox__info {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 20px;
    justify-content: center;
    font-size: 1rem;
    color: rgba(255,255,255,.8)
  }

  .lightbox .splide__pagination {
    bottom: 5px;
  }

  .lightbox .splide__arrow {
    background: transparent;
    opacity: .5;
  }

  .lightbox .splide__arrow svg {
    fill: #fff;
  }

  .lightbox .splide__arrow--prev {
    left: -50px;
  }

  .lightbox .splide__arrow--next {
    right: -50px;
  }

  .lightbox__footer {
    /* position: absolute; */
    bottom: 0;
    width: 100%;
    padding: 10px 10px 40px;
  }
</style>
