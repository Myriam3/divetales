<% content_for :meta_title, "Dive Photo from #{@picture.dive.dive_site_name} | Dive Tales" %>
<% content_for :meta_description, "View this underwater photograph taken at #{@picture.dive.dive_site_name}." %>

<% if @picture %>
  <div class="picture">
    <% if @picture.photo.attached? %>
    <%
      @picture.photo.analyze if !@picture.photo.metadata[:width] || !@picture.photo.metadata[:height]
      picture_width = @picture.photo.metadata[:width]
      picture_height = @picture.photo.metadata[:height]
      ratio = picture_width.present? && picture_height.present? ? picture_width.to_f / picture_height.to_f : 1.3
      max_width_wide = case
                        when ratio < 0.7
                        "600px"
                        when ratio.round(1) < 1
                        "800px"
                        when ratio.round(1) < 1.3
                        "1296px"
                        when ratio.round(2) < 1.5
                        "1500px"
                        else
                        "100%"
                      end
    %>
      <div class="picture__wrapper" style="--max-width-wide: <%= max_width_wide %>">
        <%= cl_image_tag @picture.photo.key, class: "" %>
      </div>
    <% else %>
      <div class="picture__wrapper picture__wrapper--placeholder">
        <%= render "shared/icon", icon_name: "fish-bone", icon_size: 80 %>
      </div>
    <% end %>

    <div class="picture__info">
        <div class="picture__info-top">
          <div class="picture__info-top-content">
            <% if @picture.species.any? %>
              <ul class="picture__info-top-list list-unstyled">
                <% @picture.species.each do |s| %>
                  <li>
                    <%= render "species_card", species: s %>
                  </li>
                <% end %>
              </ul>
            <% else %>
                <div class="my-4 text-center">
                  <p class="mt-2">
                    <%= render "shared/icon", icon_name: "photo-question" %>
                    No identified species
                  </p>

                  <p class="mt-3">
                    <%= link_to identification_path(picture_id: @picture.id, dive_id: @picture.dive.id), class: "btn-dive btn-dive-accent" do %>
                    <%= render "shared/icon", icon_name: "photo-spark" %>
                    Identify this picture
                    <% end %>
                  </p>
                </div>
            <% end %>

            <div class="picture__info-top-btn">
              <%= render "shared/edit_photo" %>
              <%= render "shared/delete_photo" %>
            </div>
          </div>
        </div>

        <div class="picture__info-details" data-controller="picture-info-tab">
          <div class="picture__info-tab pt-3 pb-0 px-4">
            <!-- The Tab Navigation -->
            <ul class="picture__info-tab-menu nav nav-tabs" id="pictureTabs" role="tablist">
              <li class="nav-item" role="presentation">
                <button class="nav-link active pb-3" id="photo-details-tab" role="tab" aria-controls="photo-details" aria-selected="true"
                        type="button"
                        data-picture-info-tab-target="tab"
                        data-action="click->picture-info-tab#switch"
                        data-target-id="photo-details">
                  <%= render "shared/icon", icon_name: "camera" %> Photo Details
                </button>
              </li>

              <% if @picture.species.any? %>
                <li class="nav-item" role="presentation">
                  <button class="nav-link fw-bold text-secondary border-0 bg-transparent pb-3"
                    type="button"
                    data-picture-info-tab-target="tab"
                    data-action="click->picture-info-tab#switch"
                    data-target-id="species-details">
                    <%= render "shared/icon", icon_name: "fish" %> Species Details
                  </button>
                </li>
              <% end %>
            </ul>
          </div>

          <div class="picture__info-tab-content p-4">
            <div class="tab-content">
              <div class="tab-pane fade show active" id="photo-details" role="tabpanel" aria-labelledby="photo-details-tab" data-picture-info-tab-target="panel">
                <%= render "tab_picture_details", picture: @picture %>
              </div>

              <% if @picture.species.any? %>
                <div class="tab-pane fade" id="species-details" role="tabpanel" aria-labelledby="species-details-tab" data-picture-info-tab-target="panel">
                  <%= render "tab_species_details", picture: @picture %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
    </div>
  </div>

  <% @related_species.each do |species, pictures| %>
    <% if pictures.any? %>
      <% is_related_species = true %>
      <section class="picture-related <%= "picture-related--bg" if @related_categories.values.flatten.any? %>">
        <div class="container">
          <h2 class="picture-related__title">
            More <%= pictures.count > 1 ?  species.name.pluralize : species.name %>
          </h2>

          <ul class="picture-related__list list-unstyled">
            <% pictures.each do |picture| %>
              <% if picture.photo.attached? %>
                <li>
                  <%= link_to picture_path(picture), class: "picture-related__img" do %>
                    <%= image_tag picture.photo, loading: "lazy", alt: "" %>
                  <% end %>
                </li>
              <% end %>
            <% end %>
          </ul>
        </div>
      </section>
    <% end %>
  <% end %>

    <% related_species_ids = @related_species.values.flatten.map(&:id) %>
    <% @related_categories.each do |category, pictures| %>
      <% pictures = pictures.reject { |picture| related_species_ids.include?(picture.id) } %>
      <% if pictures.any? %>
          <section class="picture-related">
            <div class="container">
              <h2 class="picture-related__title">More <%= category.name %> Photos</h2>

              <ul class="picture-related__list list-unstyled">
                <% pictures.each do |picture| %>
                  <% if picture.photo.attached? %>
                    <li>
                      <%= link_to picture_path(picture), class: "picture-related__img" do %>
                        <%= image_tag picture.photo, loading: "lazy", alt: "" %>
                      <% end %>
                    </li>
                  <% end %>
                <% end %>
              </ul>
            </div>
          </div>
      </section>
      <% end %>
  <% end %>

  <%= render "shared/delete_modal", picture: @picture %>
<% end %>
