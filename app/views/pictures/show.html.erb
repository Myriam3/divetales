<div class="mt-5 mb-2">
  <%= link_to dive_path(@picture.dive, anchor: "pictures"), class: "text-decoration-none" do %>
    <%= render "shared/icon", icon_name: "arrow-left" %>
    Dive pictures
  <% end %>
</div>

<div class="mb-5">
  <%= link_to pictures_path, class: "text-decoration-none" do %>
    <%= render "shared/icon", icon_name: "arrow-left" %>
    All pictures
  <% end %>
</div>

<% if @picture %>
  <div class="row g-5">
    <div class="col-12 col-lg-7">
      <div class="card shadow-sm border-0 overflow-hidden mb-3">
        <% if @picture.photo.attached? %>
          <%= cl_image_tag @picture.photo.key, class: "w-100 object-fit-cover", style: "max-height: 80vh;" %>
        <% else %>
          <div class="bg-light d-flex align-items-center justify-content-center" style="height: 400px;">
            <%= render "shared/icon", icon_name: "fish", icon_size: 64, class: "text-muted" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="col-12 col-lg-5">
      <div>
        <strong>Species</strong>

        <% if @picture.species.any? %>
          <% @picture.species.each do |s| %>
            <p>
              <%= render "shared/icon", icon_name: "photo-check" %>
              <%= s.name %>
            </p>
          <% end %>
          <p>
            <%= render "shared/icon", icon_name: "pencil" %>
            <%= link_to "Edit identification", "#" %>
          </p>
        <% else %>
          <p>
            <%= render "shared/icon", icon_name: "photo-question" %>
            Unidentified
          </p>
          <p>
            <%= render "shared/icon", icon_name: "photo-spark" %>
            <%= link_to "Identify this picture", identification_path(picture_id: @picture.id, dive_id: @picture.dive.id) %>
          </p>
        <% end %>
      </div>
      <%= render "shared/picture_info",
          picture: @picture,
          dive: @picture.dive,
          details: true %>

      <div>
        <strong>Related Logs</strong>

        <p>
          <%= render "shared/icon", icon_name: "scuba-mask" %>
          <%= link_to "View Dive Log", dive_path(@picture.dive) %>
        </p>

        <p>
          <%= render "shared/icon", icon_name: "luggage" %>
          <%= link_to "Trip: #{@picture.dive.trip.title}", trip_path(@picture.dive.trip) %>
        </p>
      </div>
    </div>
  </div>

  <!-- TODO refactor -->
  <% @related_species.each do |species, pictures| %>
    <% if pictures.any? %>
      <h2 class="mt-5">Other <%= species.name %> pictures</h2>

      <div class="d-flex gap-2 overflow-auto">
        <% pictures.each do |picture| %>
          <% if picture.photo.attached? %>
            <%= link_to picture_path(picture) do %>
              <%= image_tag picture.photo,
                  class: "rounded object-fit-cover",
                  style: "width: 100px; height: 100px;" %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% @related_categories.each do |category, pictures| %>
        <% if pictures.any? %>
          <h2>Other <%= category.name %> pictures</h2>

          <div class="d-flex gap-2 overflow-auto">
            <% pictures.each do |picture| %>
              <% if picture.photo.attached? %>
                <%= link_to picture_path(picture) do %>
                  <%= image_tag picture.photo,
                      class: "rounded object-fit-cover",
                      style: "width: 100px; height: 100px;" %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>
<% end %>
