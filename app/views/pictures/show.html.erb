<div class="mt-5 mb-2">
  <%= link_to dive_path(@picture.dive, anchor: "pictures"), class: "text-decoration-none" do %>
    <%= render "shared/icon", icon_name: "arrow-left" %>
    Dive pictures
  <% end %>
</div>

<div class="mb-5">
  <%= link_to pictures_path, class: "text-decoration-none" do %>
    <%= render "shared/icon", icon_name: "arrow-left" %>
    All pictures
  <% end %>
</div>

<% if @picture %>
  <div class="row g-5">
    <div class="col-12 col-lg-7">
      <div class="card shadow-sm border-0 overflow-hidden mb-3">
        <% if @picture.photo.attached? %>
          <%= cl_image_tag @picture.photo.key, class: "w-100 object-fit-cover", style: "max-height: 80vh;" %>
        <% else %>
          <div class="bg-light d-flex align-items-center justify-content-center" style="height: 400px;">
            <%= render "shared/icon", icon_name: "fish", icon_size: 64, class: "text-muted" %>
          </div>
        <% end %>
      </div>

      <% if @picture.photo.attached? && @picture.photo.metadata.present? %>
          <div class="d-flex flex-wrap gap-2 mt-3">

            <% if @picture.photo.metadata["camera_model"].present? %>
              <span class="badge bg-light text-secondary border px-3 py-2 fs-6 fw-normal d-flex align-items-center">
                <%= render "shared/icon", icon_name: "camera", class: "me-2" %>
                <%= @picture.photo.metadata["camera_model"] %>
              </span>
            <% end %>

            <% if @picture.photo.metadata["date_taken"].present? %>
              <span class="badge bg-light text-secondary border px-3 py-2 fs-6 fw-normal d-flex align-items-center">
                <%= render "shared/icon", icon_name: "calendar", class: "me-2" %>
                <%= @picture.photo.metadata["date_taken"] %>
              </span>
            <% end %>

            <% if @picture.photo.metadata["gps_latitude"].present? %>
              <span class="badge bg-light text-secondary border px-3 py-2 fs-6 fw-normal d-flex align-items-center">
                <%= render "shared/icon", icon_name: "map-pin", class: "me-2" %>
                <%= @picture.photo.metadata["gps_latitude"].round(4) %>, <%= @picture.photo.metadata["gps_longitude"].round(4) %>
              </span>
            <% end %>
          </div>
        <% end %>
    </div>

    <div class="col-12 col-lg-5">
      <% if @picture.species.any? %>
        <h1 class="display-6 fw-bold mb-1"><%= @picture.species.map(&:name).to_sentence %></h1>
      <% end %>

      <p class="text-muted fs-5 mb-0">
        <% site_name = @picture.dive.dive_site_name.presence || @picture.dive.location.name %>
        found in "<%= site_name %>"
      </p>
    </div>

      <%= render "shared/picture_info",
          picture: @picture,
          dive: @picture.dive,
          details: true %>

      <p>
        <%= link_to dive_path(@picture.dive), class: "text-decoration-none" do %>
          <%= render "shared/icon", icon_name: "scuba-mask" %>
          See dive
        <% end %>
      </p>

      <% if @picture.species.any? %>
        <h2 class="mt-5 mb-3"><%= render "shared/icon", icon_name: "photo-check", icon_size: 36 %> Identified species</h2>

        <%= render "shared/species_list", species: @picture.species %>
      <% else %>
        <%= render "shared/icon", icon_name: "photo-question", icon_size: 36 %> No species identified

        <p class="mt-3">
          <%= link_to "#", class: "btn btn-secondary" do %>
          <%= render "shared/icon", icon_name: "photo-spark" %>
            Identify this species
          <% end %>
        </p>
      <% end %>
    </div>
  </div>

  <!-- TODO refactor -->
  <% @related_species.each do |species, pictures| %>
    <% if pictures.any? %>
      <h2 class="mt-5">Other <%= species.name %> pictures</h2>

      <div class="d-flex gap-2 overflow-auto">
        <% pictures.each do |picture| %>
          <% if picture.photo.attached? %>
            <%= link_to picture_path(picture) do %>
              <%= image_tag picture.photo,
                  class: "rounded object-fit-cover",
                  style: "width: 100px; height: 100px;" %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% @related_categories.each do |category, pictures| %>
        <% if pictures.any? %>
          <h2>Other <%= category.name %> pictures</h2>

          <div class="d-flex gap-2 overflow-auto">
            <% pictures.each do |picture| %>
              <% if picture.photo.attached? %>
                <%= link_to picture_path(picture) do %>
                  <%= image_tag picture.photo,
                      class: "rounded object-fit-cover",
                      style: "width: 100px; height: 100px;" %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>
<% end %>
