<div id="dives-select-container"
     data-picture-form-target="divesContainer"
     style="display: <%= @dives.any? ? 'block' : 'none' %>;">

  <label for="picture_dive_id" class="form-label">
    <%= render "shared/icon", icon_name: "scuba-mask" %>
    Select a dive*
  </label>

  <% options = @dives.each_with_index.map do |dive, index|
      title = ""
      title += "##{dive.dive_number} " if dive.dive_number.present?
      title += dive.dive_site_name.presence || dive.location.name
      title += ", #{dive.date}"
      title += ", #{dive.start_time.strftime('%H:%M')}" if dive.start_time.present?
      [title, dive.id]
  end %>

  <%= select_tag "picture[dive_id]",
      options_for_select(options, @selected_dive_id),
      selected: @selected_dive_id,
      prompt: "Select a dive *",
      class: "form-select",
      autocomplete: "off",
      data: {
        "picture-form-target": "dive",
        action: "change->picture-form#validate change->picture-form#selectDive"
      } %>
</div>
