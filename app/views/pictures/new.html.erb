<div class="trips-hero">
  <h1>Upload your picutures</h1>
  <h2>See beneath the surface.</h2>
  <p>Keep your favorite ocean encounters alive.</p>
</div>

<div class="trips-content picture-form"
     data-controller="picture-form"
     data-picture-form-selected-trip-id-value="<%= @selected_trip_id %>"
     data-picture-form-selected-dive-id-value="<%= @selected_dive_id %>"
     data-picture-form-dives-url-value="<%= dives_for_trip_pictures_path %>"
>
  <%= form_with url: bulk_create_pictures_path, method: :post, local: true, html: { multipart: true } do %>

    <div class="mb-4">
      <label for="pictures_bulk_photos" class="form-label fw-bold">
        <%= render "shared/icon", icon_name: "camera-spark" %>
        Select up to 5 photos *
      </label>
      <%= file_field_tag "pictures_bulk[photos][]",
        multiple: true,
        class: "form-control",
        id: "pictures_bulk_photos",
        data: {
          "picture-form-target": "photo",
          action: "change->picture-form#validate"
        } %>

      <div data-picture-form-target="error" class="text-danger mt-2 small d-none fw-bold">
        <%= render "shared/icon", icon_name: "alert-circle" %>
        You can only select up to 5 photos at a time.
      </div>

      <div data-picture-form-target="previewContainer" class="mt-3"></div>
    </div>

    <%= render "pictures/form", trips: @trips, selected_trip_id: @selected_trip_id %>

    <%= hidden_field_tag "pictures_bulk[dive_id]", @selected_dive_id, data: { "picture-form-target": "bulkDiveId" } %>

    <div class="mt-5">
      <%= button_tag type: "submit",
        class: "btn-dive btn-dive-primary",
        disabled: true,
        data: {
          "picture-form-target": "submit"
        } do %>
        <%= render "shared/icon", icon_name: "camera-up" %>
        Upload
      <% end %>
    </div>
  <% end %>
</div>
