<%= form_with url: pictures_path, method: :get, local: true, html: { class: "row g-3 mb-4" } do %>
  <div class="col-auto">
    <%= select_tag :trip_id,
      options_from_collection_for_select(@trips, :id, :title, params[:trip_id]),
      prompt: "All trips",
      class: "form-select" %>
  </div>

  <div class="col-auto">
    <%= select_tag :location_id,
      options_from_collection_for_select(@locations, :id, :name, params[:location_id]),
      prompt: "All locations",
      class: "form-select" %>
  </div>

<div class="col-auto">
  <%= select_tag :year,
    options_for_select(@years.map { |y| [y.to_i, y.to_i] }, params[:year]),
    prompt: "All years",
    class: "form-select" %>
</div>

<div class="col-auto">
  <%= select_tag :category_id,
    options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
    prompt: "All categories",
    class: "form-select" %>
</div>

  <div class="col-auto">
    <%= select_tag :sort,
      options_for_select([
        ["Newest first", "date_desc"],
        ["Oldest first", "date_asc"],
        ["Trip name", "trip"],
        ["Location name", "location"]
      ], params[:sort]),
      class: "form-select" %>
  </div>

  <div class="col-auto">
    <%= submit_tag "Apply", class: "btn btn-secondary" %>
  </div>

  <% if params[:trip_id].present? || params[:location_id].present? || params[:year].present? || params[:sort].present? %>
    <div class="col-auto">
      <%= link_to "Clear filters", pictures_path, class: "btn btn-outline-secondary" %>
    </div>
  <% end %>
<% end %>
<h1 class="mt-5 mb-1">Pictures</h1>
<div class="d-flex justify-content-evenly">
  <p class="mt-3 text-center">
    <%= link_to identification_path, class: "btn btn-secondary" do %>
    <%= render "shared/icon", icon_name: "photo-spark" %>
      Identify a species
    <% end %>
  </p>

  <p class="mt-3 text-center">
    <%= link_to new_picture_path, class: "btn btn-secondary" do %>
    <%= render "shared/icon", icon_name: "camera-spark" %>
      Add a picture
    <% end %>
  </p>
</div>

<% if @pictures.any? %>
  <div data-controller="picture-card">
    <div class="mb-3 text-center">
      <button
        type="button"
        class="btn btn-outline-secondary"
        data-action="click->picture-card#toggle"
        data-picture-card-target="button"
      >
        Show picture info
      </button>
    </div>
    <ul class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 list-unstyled">
      <% @pictures.each do |picture| %>
        <li class="col">
          <%= render "shared/picture_card", picture: picture, show_info: false %>
        </li>
      <% end %>
    </ul>
  </div>
<% else %>
  No picture yet
<% end %>
