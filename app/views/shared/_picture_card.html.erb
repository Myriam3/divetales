<% if picture %>
  <% show_info = local_assigns.fetch(:show_info, true) %>

  <div class="card picture-card h-100 position-relative border-0 shadow-sm">
    <div class="position-absolute d-none" data-picture-selection-target="checkboxWrapper" style="top: 10px; right: 10px; z-index: 10;">
      <%= check_box_tag "picture_ids[]", picture.id, false,
            class: "form-check-input fs-3 m-0 shadow border-2 rounded-circle",
            data: {
              picture_selection_target: "checkbox",
              action: "change->picture-selection#checkSelection"
            } %>
    </div>
    <%= link_to picture_path(picture),
          class: "text-decoration-none",
          data: { action: "click->picture-selection#preventNavigation" } do %>

      <div class="card-header <%= "card-header--id" if picture.species.any? %> <%= "d-none" unless show_info %>" data-picture-card-target="info">
        <% if picture.species.any? %>
          <% picture.species.each do |s| %>
            <p class="picture-card__id-name">
              <%= render "shared/icon", icon_name: "photo-check", icon_size: 20 %> <strong><%= s.name %></strong>
            </p>
          <% end %>
        <% else %>
          <%= render "shared/icon", icon_name: "photo-question", icon_size: 20 %>
          No species identified
        <% end %>
      </div>

      <div class="ratio overflow-hidden" style="--bs-aspect-ratio: 75%;">
        <% if picture.photo.attached? %>
          <div>
            <%= image_tag picture.photo,
                  class: "position-absolute top-0 start-0 w-100 h-100 object-fit-cover",
                  loading: local_assigns[:index] && local_assigns[:index] < 3 ? "eager" : "lazy" ,
                  alt: "",
                  width: 421,
                  height: 316
            %>

            <% if picture.species_default? %>
              <span class="badge bg-secondary position-absolute bottom-0 start-0 m-2">
                Reference photo
              </span>
            <% end %>
          </div>
        <% else %>
          <svg xmlns="http://www.w3.org/2000/svg" width="270" height="270" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-fish"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M16.69 7.44a6.973 6.973 0 0 0 -1.69 4.56c0 1.747 .64 3.345 1.699 4.571" /><path d="M2 9.504c7.715 8.647 14.75 10.265 20 2.498c-5.25 -7.761 -12.285 -6.142 -20 2.504" /><path d="M18 11v.01" /><path d="M11.5 10.5c-.667 1 -.667 2 0 3" /></svg>
        <% end %>
      </div>

      <div class="card-body <%= "d-none" unless show_info %>" data-picture-card-target="info">
        <% if picture.species.any? %>
        <div class="picture-card__id-list">
          <% picture.species.each do |s| %>
          <div>
            <span class="badge badge--species badge--category">
              <span class="visually-hidden">Category:</span>
              <%= render "shared/icon", icon_name: "fish", icon_size: 16 %>
              <%= s.category.name&.titleize %></span>
              <% if s.details.present? %>
                <% family = s.details&.dig("family")&.titleize %>
                <% if family.present? %>
                  <span class="badge badge--species badge--family">
                    <%= render "shared/icon", icon_name: "binary-tree", icon_size: 16 %>
                    Family: <%= s.details&.dig("family")&.titleize %>
                  </span>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
        <% end %>
        <%= render "shared/picture_info", picture: picture, dive: picture.dive %>
      </div>
    <% end %>
  </div>
<% end %>
