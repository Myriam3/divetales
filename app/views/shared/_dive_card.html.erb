<% if dive %>
  <%
    all_page = current_page?(dives_path) || current_page?(root_path)
  %>

  <%= link_to(
      all_page ? dive_path(dive) : trip_dive_path(dive.trip, dive),
      class: 'card text-decoration-none text-reset'
    ) do %>
    <div class="card-body">
      <% if local_assigns[:heading_level] == 3 %>
        <h3 class="card-title"><%= dive.display_name_html %></h3>
      <% else %>
        <h2 class="card-title"><%= dive.display_name_html %></h2>
      <% end %>

      <% if all_page %>
        <p>
        <%= render "shared/icon", icon_name: "luggage", label: "Trip: " %>
        <%= dive.trip.title %>
      </p>
      <% end %>
      <p>
        <%= render "shared/icon", icon_name: "calendar", label: "Date: " %>
        <%= dive.date.strftime("%Y-%m-%d") %>
        <% unless dive.start_time.blank? %>
          <%= dive.start_time.strftime("%H:%M") %>
        <% end %>
      </p>

      <% unless dive.dive_site_name.blank? %>
      <p>
        <%= render "shared/icon", icon_name: "anchor", label: "Dive site: " %>
        <%= dive.dive_site_name %>
      </p>
      <% end %>

      <p>
        <%= render "shared/icon", icon_name: "world-pin", label: "Location: " %>
        <%= dive.location.name %>
        <%= icon dive.location.country.code.downcase, library: "flags", width: 20, height: 20 %>
        <span class="visually-hidden"><%= dive.location.country.name %></span>
      </p>

      <% species = dive.pictures.flat_map(&:species).uniq %>
      <% if species.any? %>
        <p>
          <%= render "shared/icon", icon_name: "fish" %>
          <%= species.count %> species identified
        </p>
      <% end %>

      <% if dive.pictures.any? %>
        <p>
          <%= render "shared/icon", icon_name: "camera-spark" %>
          <%= dive.pictures.count %> pictures
        </p>
      <% end %>

      <% unless dive.max_depth.blank? %>
        <p>
          <%= render "shared/icon", icon_name: "arrow-bar-to-down" %>
          <span>Max-depth:</span>
          <%= number_with_precision(dive.max_depth, precision: 1, strip_insignificant_zeros: true) %>m
        </p>
      <% end %>
    </div>
  <% end %>
<% end %>
