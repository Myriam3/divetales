<div class="modal fade" id="deletePictureModal" tabindex="-1" aria-labelledby="deletePictureModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow">

      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold" id="deletePictureModalLabel">Are you sure you want to delete this photo?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body text-secondary">
        This action cannot be undone. Where would you like to go next?
      </div>

      <div class="modal-footer border-top-0 d-flex flex-column gap-2 align-items-stretch pt-0">

        <%= link_to picture_path(@picture, return_to: "dive"),
            data: { turbo_method: :delete },
            class: "btn btn-outline-danger fw-bold rounded-pill" do %>
          Delete & Return to Dive
        <% end %>

        <%= link_to picture_path(@picture, return_to: "gallery"),
            data: { turbo_method: :delete },
            class: "btn btn-outline-danger fw-bold rounded-pill" do %>
          Delete & Return to All Pictures
        <% end %>

        <button type="button" class="btn btn-light fw-bold rounded-pill mt-2" data-bs-dismiss="modal">Cancel</button>

      </div>
    </div>
  </div>
</div>
