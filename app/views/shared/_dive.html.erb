<% if dive %>
  <p>
    <%= render "shared/icon", icon_name: "calendar", label: "Date: " %>
    <%= dive.date %>
  </p>

  <% if dive.dive_types.any? %>
    <p>
      <%= render "shared/icon", icon_name: "scuba-diving" %>
      <span>Dive types:</span>
      <% dive.dive_types.each do |type| %>
        <span class="badge text-bg-secondary">
          <%= type.capitalize %>
        </span>
      <% end %>
    </p>
  <% end %>

  <% unless dive.dive_site_name.blank? %>
    <p>
      <%= render "shared/icon", icon_name: "anchor", label: "Dive site: " %>
      <%= dive.dive_site_name %>
    </p>
  <% end %>

  <% unless dive.latitude.blank? || dive.longitude.blank? %>
    <p>
      <%= render "shared/icon", icon_name: "map-pin", label: "Coordinates: " %>
      <%= dive.latitude %>,<%= dive.longitude %>
    </p>
  <% end %>

  <p>
    <%= render "shared/icon", icon_name: "world-pin", label: "Location: " %>
    <%= dive.location.name %>
  </p>

  <p>
    <%= icon dive.location.country.code.downcase, library: "flags", width: 20, height: 20 %>
    <%= dive.location.country.name %>
  </p>

  <hr>

  <p>
    <%= link_to trip_path(dive.trip), class: "text-decoration-none" do %>
      <%= render "shared/icon", icon_name: "luggage", label: "Trip:" %>
      <%= @dive.trip.title %>
    <% end %>
  </p>

  <hr>

  <!-- TODO -->
  <p>
    <%= render "shared/icon", icon_name: "camera-spark" %>
    20 pictures (TODO)
    <br>
    <%= link_to "See pictures", "#species"%>
  </p>

  <p>
    <%= render "shared/icon", icon_name: "fish" %>
    15 species (TODO) <br>
    <span class="badge text-bg-secondary">Frogfish</span>
    <span class="badge text-bg-secondary">Mantas</span>
    <span class="badge text-bg-secondary">Whitetip reef shark</span>
    <br>
    <%= link_to "See all species", "#species"%>
  </p>

  <hr>

  <h2>Log</h2>

  <% unless dive.duration.blank? %>
    <p>
      <%= render "shared/icon", icon_name: "clock" %>
      <span>Duration:</span>
      <%= dive.duration %>min
    </p>
  <% end %>

  <!-- TODO -->

  <p>
    <%= render "shared/icon", icon_name: "ripple-down" %>
    <span>Start:</span>
    datetime (TODO)
  </p>

  <p>
    <%= render "shared/icon", icon_name: "ripple-up" %>
    <span>End:</span>
    datetime (TODO)
  </p>

  <p>
    <%= render "shared/icon", icon_name: "scuba-diving-tank", label: "Tank:" %>
    Air or Nitrox (TODO)
  </p>

  <p>
    <%= render "shared/icon", icon_name: "gauge", label: "Gauge:" %>
    Pressure start / end (TODO)
  </p>

  <% unless dive.max_depth.blank? %>
    <p>
      <%= render "shared/icon", icon_name: "arrow-bar-to-down" %>
      <span>Max-depth:</span>
      <%= number_with_precision(dive.max_depth, precision: 1, strip_insignificant_zeros: true) %>m
    </p>
  <% end %>

  <% unless dive.avg_depth.blank? %>
    <p>
      <%= render "shared/icon", icon_name: "arrows-down-up" %>
      <span>Average depth:</span>
      <%= number_with_precision(dive.avg_depth, precision: 1, strip_insignificant_zeros: true) %>m
    </p>
  <% end %>

  <% unless dive.avg_temp.blank? %>
    <p>
      <%= render "shared/icon", icon_name: "temperature" %>
      <span>Average temperature:</span>
      <%= number_with_precision(dive.avg_temp, precision: 1, strip_insignificant_zeros: true) %>°C
    </p>
  <% end %>

  <% unless dive.min_temp.blank? %>
    <p>
      <%= render "shared/icon", icon_name: "temperature-minus" %>
      <span>Temperature min:</span>
      <%= number_with_precision(dive.min_temp, precision: 1, strip_insignificant_zeros: true) %>°C
    </p>
  <% end %>

  <% unless dive.max_temp.blank? %>
    <p>
      <%= render "shared/icon", icon_name: "temperature-plus" %>
      <span>Temperature max:</span>
      <%= number_with_precision(dive.max_temp, precision: 1, strip_insignificant_zeros: true) %>°C
    </p>
  <% end %>

  <hr>

  <h2>Memo</h2>

  <% unless dive.note.blank? %>
    <p>
      <%= render "shared/icon", icon_name: "notebook" %>
      <%= dive.note %>
    </p>
  <% end %>
<% end %>

<hr>

<h2 id="species">Pictures/Species</h2>

