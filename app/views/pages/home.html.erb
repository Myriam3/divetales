<% content_for :title, "DiveTales" %>

<section class="home-hero">
  <div class="home-bubbles">
    <%= image_tag "home-title-bubbles.png", alt: "", class: "home-title-bubbles" %>
  </div>

  <div class="home-title">
    <%= image_tag "home-wave.png", alt: "", class: "home-wave home-wave-left" %>

    <div class="home-title-text">
      <h1>DIVE TALES</h1>
      <p>Every dive has a story.</p>
    </div>

    <%= image_tag "home-wave.png", alt: "", class: "home-wave home-wave-right" %>
  </div>

  <div class="home-dashboard">
    <div class="home-dashboard__main">
      <% if @ongoing_trip.present? %>
        <%= link_to trip_path(@ongoing_trip), class: "home-ongoing-trip-link" do %>
          <article class="card shadow-sm home-ongoing-trip">
            <div class="card-header bg-white">
              <p class="mb-0 dive-text">
                <%= render "shared/icon", icon_name: "plane", icon_size: 24 %>
                Ongoing trip</p>
            </div>

            <div class="card-body">
              <h2 class="dive-page__title"><%= render "shared/icon", icon_name: "luggage", icon_size: 30 %><%= @ongoing_trip.title %></h2>

              <p class="dive-text">
                <%= @ongoing_trip.start_date.strftime("%d %B %Y") %> -
                <%= @ongoing_trip.end_date.strftime("%d %B %Y") %>
              </p>

              <% if @ongoing_trip.info.present? %>
                <p class="dive-muted"><%= @ongoing_trip.info %></p>
              <% end %>

              <span class="btn-dive btn-dive-primary">View trip</span>
            </div>
          </article>
        <% end %>
      <% else %>
        <article class="card shadow-sm home-ongoing-trip">
          <div class="card-body">
            <h2>Last trip</h2>
            <p>The selected trip could not be found.</p>
          </div>
        </article>
      <% end %>

      <%# TODO: Remove this placeholder when the real dive heat map is added. %>
      <section class="card shadow-sm home-heat-map-placeholder">
        <div class="card-header bg-white">
          <p class="mb-0 dive-text">
            <%= render "shared/icon", icon_name: "map", icon_size: 24 %>
            Dive heat map</p>
        </div>

        <div class="card-body">
          <%= image_tag "dive_heatmap.png",
            alt: "Map of dive locations in Southeast Asia and Japan",
            class: "w-100 object-fit-cover rounded-bottom" %>
        </div>
      </section>
    </div>

    <aside class="home-dashboard__discoveries">
      <%= render "shared/latest_species", species: @latest_species %>
    </aside>
  </div>

  <section class="home-photo-slider"
      data-controller="slider"
      data-slider-type-value="slide"
      data-slider-arrows-value="false"
      data-slider-width-value="210"
      data-slider-pagination-value="false">

    <div class="splide"
        aria-label="Latest pictures"
        data-slider-target="sliderContainer">

      <div class="splide__track">
        <ul class="splide__list list-unstyled">
          <% @media_gallery.take(5).each do |dive| %>
            <% dive.pictures.take(3).each do |photo| %>
              <% if photo.photo.present?%>
              <li class="splide__slide">
                <div class="position-relative">
                  <%= image_tag photo.photo.variant(resize_to_fill: [220, 220]),
                      class: "w-100 object-fit-cover rounded shadow-sm home-photo-slider__image",
                      alt: "Dive media from #{dive.dive_site_name}" %>

                  <span class="position-absolute bottom-0 start-0 w-100 p-1 text-white text-truncate"
                        style="font-size: 0.7rem; background: rgba(0,0,0,0.5);">
                    <%= dive.location.name %>
                  </span>
                </div>
              </li>
              <% end %>
            <% end %>
          <% end %>
        </ul>
      </div>
    </div>
  </section>

    <div class="home-fish home-fish-one">
      <%= image_tag "home-fish-purple.png", alt: "", loading: "lazy" %>
    </div>

    <div class="home-fish home-fish-two">
      <%= image_tag "home-fish-pink.png", alt: "", loading: "lazy" %>
    </div>

    <div class="home-fish home-fish-three">
      <%= image_tag "home-fish-purple.png", alt: "", loading: "lazy" %>
    </div>

    <div class="home-fish home-fish-four">
      <%= image_tag "home-fish-yellow.png", alt: "", loading: "lazy" %>
    </div>

    <div class="home-fish home-fish-five">
      <%= image_tag "home-fish-purple.png", alt: "", loading: "lazy" %>
    </div>

    <%= render "shared/footer_wave" %>
  </section>
