<% content_for :title, "DiveTales" %>

<section class="home-hero">
  <div class="home-bubbles">
    <%= image_tag "home-title-bubbles.png", alt: "", class: "home-title-bubbles" %>
  </div>

  <div class="home-title">
    <%= image_tag "home-wave.png", alt: "", class: "home-wave home-wave-left" %>

    <div class="home-title-text">
      <h1>DIVE TALES</h1>
      <p>Every dive has a story.</p>
    </div>

    <%= image_tag "home-wave.png", alt: "", class: "home-wave home-wave-right" %>
  </div>

  <div class="home-content">
    <%= render "shared/latest_species", species: @latest_species %>
    <%= render "shared/media_gallery", dives: @media_gallery %>
  </div>

    <div class="mt-5"
        data-controller="slider"
        data-slider-page-value="3"
        data-slider-arrows-value="false"
        data-slider-type-value="slide"
        data-slider-rewind-value="false"
        data-slider-width-value="270"
        data-slider-padding-value="calc((100vw - 1100px - (1.5rem * 2)) / 2)",
        data-slider-pagination-value="false">
    <div class="splide"
          aria-label="Lastest pictures"
          data-slider-target="sliderContainer"
      >
        <div class="splide__track">
          <ul class="splide__list list-unstyled">
            <% @media_gallery.each do |dive| %>
              <% dive.pictures.take(3).each do |photo| %>
                <li class="splide__slide">
                  <div class="position-relative">
                    <%= image_tag photo.photo.variant(resize_to_fill: [280, 280]),
                        class: "w-100 h-100 object-fit-cover rounded shadow-sm",
                        alt: "Dive media from #{dive.dive_site_name}" %>

                      <span class="position-absolute bottom-0 start-0 w-100 p-1 text-white text-truncate"
                            style="font-size: 0.7rem; background: rgba(0,0,0,0.5); border-bottom-left-radius: var(--bs-border-radius); border-bottom-right-radius: var(--bs-border-radius);">
                        <%= dive.location.name %>
                      </span>
                  </div>
                </li>
              <% end %>
            <% end %>
          </ul>
        </div>
    </div>
  </div>

  <div class="home-fish home-fish-one">
    <%= image_tag "home-fish.png", alt: "" %>
  </div>

  <div class="home-fish home-fish-two">
    <%= image_tag "home-fish.png", alt: "" %>
  </div>

  <div class="home-fish home-fish-three">
    <%= image_tag "home-fish.png", alt: "" %>
  </div>

  <div class="home-fish home-fish-four">
    <%= image_tag "home-fish.png", alt: "" %>
  </div>

  <div class="home-fish home-fish-five">
    <%= image_tag "home-fish.png", alt: "" %>
  </div>

  <%= image_tag "home-diving-helmet.png", alt: "Vintage diving helmet", class: "home-diving-helmet" %>
  <%= image_tag "home-coral-reef.png", alt: "Colorful coral reef", class: "home-coral" %>
  <%# image_tag "test_4.png", alt: "Colorful coral reef", class: "home-coral" %>
</section>
