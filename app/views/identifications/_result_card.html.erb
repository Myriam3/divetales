<div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
  <!-- Header: Names & Confidence -->
  <div class="flex justify-between items-start mb-4">
    <div>
      <h3 class="text-xl font-bold text-gray-900">
        <%= result[:common_name].presence || "Unknown Common Name" %>
      </h3>
      <p class="text-sm italic text-gray-500">
        <%= result[:scientific_name] %>
      </p>
    </div>

    <div class="flex-shrink-0 ml-4">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-blue-100 text-blue-800">
        <%= result[:confidence] %>% Match
      </span>
    </div>
  </div>

  <!-- Reasoning -->
  <div class="mb-4">
    <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wider mb-1">Reasoning</h4>
    <p class="text-gray-600 text-sm">
      <%= result[:reasoning] %>
    </p>
  </div>

  <!-- Evidence (Array iteration) -->
  <% if result[:evidence].present? && result[:evidence].any? %>
    <div class="mb-4">
      <h4 class="text-sm font-semibold text-gray-700 uppercase tracking-wider mb-1">Evidence</h4>
      <ul class="list-disc list-inside text-sm text-gray-600">
        <% result[:evidence].each do |item| %>
          <li><%= item %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Uncertainty / Limitations -->
  <% if result[:uncertainty].present? %>
    <div class="mt-4 bg-yellow-50 border-l-4 border-yellow-400 p-3 rounded-r-md">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h4 class="text-sm font-medium text-yellow-800">Limitations</h4>
          <p class="text-sm text-yellow-700 mt-1">
            <%= result[:uncertainty] %>
          </p>
        </div>
      </div>
    </div>
  <% end %>
</div>
