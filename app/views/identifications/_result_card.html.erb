<div class="card shadow-sm mb-4">
  <div class="card-body">
    <!-- Header: Names & Confidence -->
    <div class="d-flex justify-content-between align-items-start mb-3">
      <div>
        <% taxon = result[:inaturalist]&.find { |item| item[:default_photo_url].present? } %>
        <% photo_url = taxon&.dig(:default_photo_url) %>

        <% if photo_url.present? %>
          <div class="mb-4">
            <%= image_tag photo_url,
                  class: "img-fluid rounded",
                  style: "width: 100%; max-height: 350px; object-fit: cover;",
                  alt: result[:common_name] || result[:scientific_name] %>
          </div>
        <% end %>
        <p lass="card-title fw-bold mb-0 d-flex align-items-center gap-2">
          <%= render "shared/icon", icon_name: "fish" %>
          <%= result[:common_name].presence || "Unknown Common Name" %>
        </p>

        <p class="card-subtitle mt-1 text-muted fst-italic">
          <%= result[:scientific_name] %>
        </p>
      </div>

      <span class="badge bg-primary text-white rounded-pill px-3 py-2 d-flex align-items-center gap-1">
        <%= render "shared/icon", icon_name: "photo-check", icon_size: 16 %>
        <%= result[:confidence] %>% Match
      </span>
    </div>


    <!-- Reasoning -->
    <div class="mb-3">
      <p class="text-uppercase text-secondary small fw-bold mb-2 d-flex align-items-center gap-2">
        <%= render "shared/icon", icon_name: "bulb", icon_size: 16 %> Reasoning
      </p>

      <p class="card-text text-dark">
        <%= result[:reasoning] %>
      </p>
    </div>


    <!-- Evidence -->
    <% if result[:evidence].present? && result[:evidence].any? %>
      <div class="mb-0">
        <p class="text-uppercase text-secondary small fw-bold mb-2 d-flex align-items-center gap-2">
          <%= render "shared/icon", icon_name: "list-search", icon_size: 16 %> Evidence
        </p>

        <ul class="text-dark small ps-3 mb-0">
          <% result[:evidence].each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- View More Details -->
    <div class="mt-4 pt-3 border-top d-flex flex-column flex-sm-row justify-content-end gap-2">
      <%= link_to identification_details_path(
            scientific_name: result[:scientific_name],
            common_name: result[:common_name],
            dive_id: @dive&.id,
            identification_id: identification.id
          ),
          class: "btn btn-outline-primary d-flex align-items-center justify-content-center gap-2",
          data: { turbo: false } do %>
        <%= render "shared/icon", icon_name: "zoom-in", icon_size: 18 %> View more details
      <% end %>

      <%= link_to identification_confirm_path(
            scientific_name: result[:scientific_name],
            common_name: result[:common_name],
            identification_id: identification.id,
            dive_id: @dive&.id
          ),
          class: "btn btn-primary d-flex align-items-center justify-content-center gap-2",
          data: { turbo_frame: "_top" } do %>
        <%= render "shared/icon", icon_name: "photo-check", icon_size: 18 %> Confirm this species
      <% end %>
    </div>
  </div>


  <!-- Uncertainty / Limitations -->
  <% if result[:uncertainty].present? %>
    <div class="card-footer bg-warning-subtle text-dark-emphasis d-flex align-items-start p-3 border-top-0">

      <div class="text-warning me-3 mt-1">
        <%= render "shared/icon", icon_name: "alert-triangle", icon_size: 24 %>
      </div>

      <div>
        <p class="fw-bold mb-1">
          Limitations
        </p>

        <p class="mb-0 small">
          <%= result[:uncertainty] %>
        </p>
      </div>

    </div>
  <% end %>

</div>
