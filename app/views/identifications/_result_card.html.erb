<div class="card shadow-sm mb-4">
  <div class="card-body">
    <!-- Header: Names & Confidence -->
    <div class="d-flex justify-content-between align-items-start mb-3">
      <div>
        <h5 class="card-title fw-bold mb-0">
          <%= result[:common_name].presence || "Unknown Common Name" %>
        </h5>
        <h6 class="card-subtitle mt-1 text-muted fst-italic">
          <%= result[:scientific_name] %>
        </h6>
      </div>

      <span class="badge bg-primary text-white rounded-pill px-3 py-2">
        <%= result[:confidence] %>% Match
      </span>
    </div>

    <!-- Reasoning -->
    <div class="mb-3">
      <h6 class="text-uppercase text-secondary small fw-bold mb-1">Reasoning</h6>
      <p class="card-text text-dark">
        <%= result[:reasoning] %>
      </p>
    </div>

    <!-- Evidence -->
    <% if result[:evidence].present? && result[:evidence].any? %>
      <div class="mb-0">
        <h6 class="text-uppercase text-secondary small fw-bold mb-1">Evidence</h6>
        <ul class="text-dark small ps-3 mb-0">
          <% result[:evidence].each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <!-- View More Details -->
    <div class="text-end mt-4">
      <%= button_to "View more details →",
      identification_details_path,
      method: :post,
      params: { scientific_name: result[:scientific_name]},
      class: "btn btn-outline-primary" %>
    </div>
  </div> <!-- CLOSING THE CARD BODY HERE -->

  <!-- Uncertainty / Limitations in a Card Footer -->
  <% if result[:uncertainty].present? %>
    <div class="card-footer bg-warning-subtle text-dark-emphasis d-flex align-items-start p-3 border-top-0">
      <svg width="24" height="24" class="me-3 flex-shrink-0 text-warning" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
      </svg>
      <div>
        <h6 class="fw-bold mb-1">Limitations</h6>
        <p class="mb-0 small">
          <%= result[:uncertainty] %>
        </p>
      </div>
    </div>
  <% end %>
</div> <!-- CLOSING THE ENTIRE CARD -->
