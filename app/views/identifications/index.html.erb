<div class="identification-page bubble-background">
  <div class="trips-hero">
    <h1>Marine Life ID</h1>
    <h2>Name every encounter.</h2>
    <p>Identify the marine life that makes each of your dives unforgettable.</p>
  </div>

  <div class="trips-content">
    <%= turbo_frame_tag "identification-content" do %>

      <% if @identification&.failed? %>

        <%= render "identifications/identification_failed",
            identification: @identification,
            dive: @dive %>

      <% elsif @identification&.completed? && @results.present? %>

        <%= render "identifications/results",
            identification: @identification,
            results: @results %>

      <% else %>

        <%= render "identifications/form" %>

      <% end %>

    <% end %>
  </div>
</div>
