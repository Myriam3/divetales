<div class="confirmation-page">

  <h2>Confirm species</h2>

  <h3>
    <%= @common_name.presence || @scientific_name %>
  </h3>

  <p class="text-muted fst-italic">
    <%= @scientific_name %>
  </p>

  <% if @species.present? %>
    <p class="text-success">
      ✓ This species already exists in your species database.
    </p>

    <% if @species.default_image.attached? %>
      <p>
        Species has a default image.
      </p>
    <% end %>

  <% else %>
    <p class="text-warning">
      This species isn't in your database yet.
    </p>
  <% end %>

  <% if @image_blob.present? %>
    <p class="text-success">
      ✓ Your uploaded image is available.
    </p>

    <%= image_tag @image_blob.url,
                  class: "img-fluid",
                  style: "max-width: 400px;" %>
  <% else %>
    <p class="text-muted">
      No image was uploaded.
    </p>
  <% end %>

</div>
