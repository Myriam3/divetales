<div class="confirm-species-page">
  <h2>Confirm Identification</h2>

  <div class="species-card mb-4">
    <h3><%= @common_name %></h3>
    <p><em><%= @scientific_name %></em></p>

    <% if @image_blob %>
      <div class="user-image-preview">
        <%= image_tag @image_blob, class: "img-fluid rounded" %>
      </div>
    <% else %>
      <div class="alert alert-info">
        No image uploaded. We will use a representative image from our database for this species.
      </div>
    <% end %>
  </div>

  <%= form_with url: identification_save_path, method: :post do |f| %>
    <!-- Essential hidden fields for the save action -->
    <%= f.hidden_field :scientific_name, value: @scientific_name %>
    <%= f.hidden_field :common_name, value: @common_name %>
    <%= f.hidden_field :default_photo_url, value: @default_photo_url %>

    <div class="mb-3">
      <%= f.label :dive_id, "Which dive did you see this on?", class: "form-label" %>

      <!-- Update Dive.order to scope to the current_user's dives if you have authentication -->
      <%= f.collection_select :dive_id, Dive.order(date: :desc), :id, :dive_site_name,
                              { prompt: "Select a dive..." },
                              { class: "form-select", required: true } %>
    </div>

    <div class="d-flex gap-2">
      <button type="button" class="btn btn-outline-secondary" onclick="history.back()">Back</button>

      <!-- Using disable_with provides a great UX while the image downloads -->
      <%= f.submit "Confirm & Add to Dive",
                   class: "btn btn-primary",
                   data: { disable_with: "Saving species..." } %>
    </div>
  <% end %>
</div>
