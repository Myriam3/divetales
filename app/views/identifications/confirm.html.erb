<% content_for :meta_title, "Confirm Species | Dive Tales" %>
<% content_for :meta_description, "Review and confirm the marine life identification for your dive log." %>
<div class="confirm-species-page">
  <div class="container py-4 max-w-md mx-auto" style="max-width: 600px;">

    <h2 class="dive-heading mb-4 fw-bold">Confirm species</h2>

    <!-- Selected Species Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
      <div class="card-body p-4 d-flex align-items-center gap-3">
        <% if @default_photo_url.present? %>
          <%= image_tag @default_photo_url,
                class: "rounded-4 shadow-sm",
                style: "width: 80px; height: 80px; object-fit: cover;" %>
        <% end %>
        <div>
          <h4 class="mb-1 d-flex align-items-center gap-2 fw-bold dive-text">
            <%= render "shared/icon", icon_name: "fish", icon_size: 24 %>
            <%= @common_name.presence || "Unknown species" %>
          </h4>
          <p class="dive-muted fst-italic mb-0">
            <%= @scientific_name %>
          </p>
        </div>
      </div>
    </div>

    <!-- State 1: We already know the Dive -->
    <% if @dive.present? %>

      <div class="alert alert-success d-flex align-items-center gap-2 border-0 rounded-4 shadow-sm mb-4">
        <%= render "shared/icon", icon_name: "photo-check", icon_size: 20 %>
        This species will be added to your dive.
      </div>

      <%
        dive_title = @dive.dive_number.present? ? @dive.display_name_html() : @dive.display_name_html(include_date: true, include_time: true)
      %>

      <%= button_to identification_save_path,
            method: :post,
            params: {
              identification_id: @identification.id,
              dive_id: @dive.id,
              scientific_name: @scientific_name,
              common_name: @common_name,
              default_photo_url: @default_photo_url,
              picture_id: @picture&.id
            },
            class: "btn-dive btn-dive-primary btn-lg w-100 d-flex align-items-center justify-content-center gap-2 rounded-pill shadow-sm p-3" do %>
        <%= render "shared/icon", icon_name: "photo-check", icon_size: 20 %> Add to <%= dive_title.html_safe %>
      <% end %>

    <!-- State 2 & 3: We need to choose a Trip or Dive -->
    <% else %>

      <!-- Choosing a Dive (Inside a Trip) -->
      <% if @trip.present? %>

        <div class="d-flex justify-content-between align-items-center mb-4">
          <h5 class="mb-0 fw-bold d-flex align-items-center gap-2 text-dark">
            <%= render "shared/icon", icon_name: "scuba-mask", icon_size: 24 %> Choose a dive
          </h5>

          <%= link_to identification_confirm_path(
                identification_id: @identification.id,
                scientific_name: @scientific_name,
                common_name: @common_name,
                default_photo_url: @default_photo_url,
                picture_id: @picture&.id
              ),
              class: "btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 rounded-pill px-3" do %>
            <%= render "shared/icon", icon_name: "arrow-left", icon_size: 16 %> Back to trips
          <% end %>
        </div>

        <div class="list-group shadow-sm rounded-4 overflow-hidden border-0">
          <% @dives.each_with_index do |dive, index| %>
            <%
              dive_title = dive.dive_number.present? ? dive.display_name_html() : dive.display_name_html(include_date: true, include_time: true)
            %>

            <%= button_to identification_save_path,
                  method: :post,
                  params: {
                    identification_id: @identification.id,
                    dive_id: dive.id,
                    scientific_name: @scientific_name,
                    common_name: @common_name,
                    default_photo_url: @default_photo_url,
                    picture_id: @picture&.id
                  },
                  class: "list-group-item list-group-item-action border-0 border-bottom p-3 d-flex align-items-center gap-3" do %>
              <div class="text-primary bg-primary-subtle p-2 rounded-circle d-flex">
                <%= render "shared/icon", icon_name: "scuba-mask", icon_size: 20 %>
              </div>
              <span class="fw-medium">Add to <%= dive_title.html_safe %></span>
            <% end %>
          <% end %>
        </div>

        <% if @dives.empty? %>
          <div class="alert alert-info d-flex align-items-center gap-2 mt-4 border-0 rounded-4 shadow-sm">
            <%= render "shared/icon", icon_name: "scuba-mask" %>
            This trip doesn't have any dives yet.
          </div>
        <% end %>

      <!-- Choosing a Trip -->
      <% else %>

        <h5 class="mb-4 fw-bold d-flex align-items-center gap-2 text-dark">
          <%= render "shared/icon", icon_name: "luggage", icon_size: 24 %> Choose a trip
        </h5>

        <div class="list-group shadow-sm rounded-4 overflow-hidden border-0">
          <% @trips.each do |trip| %>
            <%= link_to identification_confirm_path(
                  scientific_name: @scientific_name,
                  common_name: @common_name,
                  default_photo_url: @default_photo_url,
                  identification_id: @identification.id,
                  trip_id: trip.id,
                  picture_id: @picture&.id
                ),
                class: "list-group-item list-group-item-action border-0 border-bottom p-3 d-flex align-items-center justify-content-between" do %>

              <div class="d-flex align-items-center gap-3">
                <div class="text-primary bg-primary-subtle p-2 rounded-circle d-flex">
                  <%= render "shared/icon", icon_name: "luggage", icon_size: 20 %>
                </div>
                <span class="fw-medium"><%= trip.title %></span>
              </div>

              <div class="text-muted">
                <!-- Using an arrow right instead of left to indicate moving forward -->
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
              </div>
            <% end %>
          <% end %>
        </div>

        <% if @trips.empty? %>
          <div class="alert alert-info d-flex align-items-center gap-2 mt-4 border-0 rounded-4 shadow-sm">
            <%= render "shared/icon", icon_name: "luggage" %>
            You don't have any trips yet.
          </div>
        <% end %>

      <% end %>

    <% end %>

  </div>
</div>
