<div id="species-details-<%= identification_id %>-<%= scientific_name.parameterize %>">
  <% if details.blank? || details["status"] == "pending" %>

  <div class="text-center py-5">
    <style>
      /* Make the fish swim up and down slightly while moving forward */
      .swimming-fish {
        width: 100px;
        height: auto;
        animation: swim 2s ease-in-out infinite alternate;
      }

      @keyframes swim {
        0% { transform: translateY(5px) translateX(-15px); }
        100% { transform: translateY(-5px) translateX(15px); }
      }

      /* Make the bubbles rise and fade */
      .bubble {
        border-radius: 50%;
        border: 2px solid #0dcaf0; /* Bootstrap Info Blue */
        animation: rise 1.5s infinite ease-in;
        opacity: 0;
        position: absolute;
      }

      @keyframes rise {
        0% { transform: translateY(15px); opacity: 0; }
        50% { opacity: 1; }
        100% { transform: translateY(-25px); opacity: 0; }
      }
    </style>

    <div class="d-flex justify-content-center align-items-center mb-4 position-relative" style="height: 80px;">

      <!-- The SVG Fish -->
      <svg class="swimming-fish" viewBox="0 0 100 60" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Body -->
        <path d="M80 30 C 80 15, 40 10, 20 30 C 40 50, 80 45, 80 30 Z" fill="#0d6efd"/>
        <!-- Tail -->
        <path d="M80 30 L 100 15 L 100 45 Z" fill="#0d6efd"/>
        <!-- Eye -->
        <circle cx="35" cy="25" r="3" fill="white"/>
        <!-- Top Fin -->
        <path d="M45 15 C 50 5, 60 5, 65 18 Z" fill="#0a58ca"/>
      </svg>

      <!-- The Bubbles -->
      <div style="position: relative; height: 100%; width: 40px; margin-left: -20px;">
        <div class="bubble" style="width: 8px; height: 8px; left: 10px; bottom: 20px; animation-delay: 0.2s;"></div>
        <div class="bubble" style="width: 12px; height: 12px; left: 25px; bottom: 10px; animation-delay: 0.7s;"></div>
        <div class="bubble" style="width: 6px; height: 6px; left: 18px; bottom: 30px; animation-delay: 1.1s;"></div>
      </div>

    </div>

    <h5 class="mt-3 text-primary">
      Researching <%= common_name.presence || scientific_name %>...
    </h5>

    <small class="text-muted">
      Fetching habitat info, behavior, and notes for divers. Hang tight!
    </small>
  </div>

<% elsif details["status"] == "failed" %>

  <div class="alert alert-danger">
    We couldn't generate the species details. Please try again.
  </div>

<% else %>
  <div class="species-details">

    <div class="mt-4 text-end">
      <%= link_to "Confirm this species",
        identification_confirm_path(
          scientific_name: details["scientific_name"],
          common_name: details["common_name"],
          default_photo_url: details["default_photo_url"],
          identification_id: identification_id,
          dive_id: dive_id
        ),
        class: "btn btn-primary",
        data: { turbo_frame: "_top" } %>
    </div>

    <!-- Species -->
    <div class="mb-4">
      <% if details["default_photo_url"].present? %>
        <div class="mb-4">
          <%= image_tag details["default_photo_url"],
                class: "img-fluid rounded",
                style: "max-height: 350px; width: 100%; object-fit: cover;",
                alt: details["common_name"].presence || details["scientific_name"] %>
        </div>
      <% end %>
      <h2>
        <%= common_name.presence || "Unknown species" %>
      </h2>

      <p class="fst-italic text-muted">
        <%= scientific_name %>
      </p>

      <% if details["family"].present? %>
        <small class="text-muted">
          Family: <%= details["family"] %>
        </small>
      <% end %>
    </div>


    <!-- Habitat & Range -->
    <div class="mb-4">
      <h5>Habitat & range</h5>

      <% if details["habitat"].present? %>
        <p>
          <strong>Habitat:</strong>
          <%= details["habitat"] %>
        </p>
      <% end %>

      <% if details["depth_range"].present? %>
        <p>
          <strong>Depth:</strong>
          <%= details["depth_range"] %>
        </p>
      <% end %>

      <% if details["distribution"].present? %>
        <p>
          <strong>Distribution:</strong>
          <%= details["distribution"] %>
        </p>
      <% end %>
    </div>


    <!-- Size & Behavior -->
    <div class="mb-4">
      <h5>Size & behavior</h5>

      <% if details["size"].present? %>
        <p>
          <strong>Size:</strong>
          <%= details["size"] %>
        </p>
      <% end %>

      <% if details["behavior"].present? %>
        <p>
          <strong>Behavior:</strong>
          <%= details["behavior"] %>
        </p>
      <% end %>
    </div>


    <!-- How to Identify -->
    <% if details["identification_features"].present? %>
      <div class="mb-4">
        <h5>How to identify</h5>

        <ul>
          <% details["identification_features"].each do |feature| %>
            <li><%= feature %></li>
          <% end %>
        </ul>
      </div>
    <% end %>


    <!-- Similar Species -->
    <% if details["similar_species"].present? %>
      <div class="mb-4">
        <h5>Similar species</h5>

        <% details["similar_species"].each do |species| %>
          <div class="mb-3">
            <strong><%= species["name"] %></strong>

            <p class="mb-0">
              <%= species["difference"] %>
            </p>
          </div>
        <% end %>
      </div>
    <% end %>


    <!-- Tips for Divers -->
    <% if details["diver_notes"].present? %>
      <div class="mb-4">
        <h5>Tips for divers</h5>

        <ul>
          <% details["diver_notes"].each do |note| %>
            <li><%= note %></li>
          <% end %>
        </ul>
      </div>
    <% end %>


    <!-- Safety -->
    <% if details["safety"].present? %>
      <div class="mb-4">
        <strong>Safety:</strong>
        <%= details["safety"] %>
      </div>
    <% end %>


    <!-- Conservation -->
    <% if details["conservation"].present? %>
      <div class="mb-4">
        <h5>Conservation</h5>

        <p>
          <%= details["conservation"] %>
        </p>
      </div>
    <% end %>


    <!-- Interesting Fact -->
    <% if details["interesting_fact"].present? %>
      <div class="mb-4">
        <h5>Interesting fact</h5>

        <p>
          <%= details["interesting_fact"] %>
        </p>
      </div>
    <% end %>

  </div>
<% end %>
</div>
