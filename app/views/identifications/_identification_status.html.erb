<div
  data-controller="identification-polling"
  data-identification-polling-interval-value="2000"
>
  <div class="text-center py-5">

    <% if identification.image.attached? %>
      <div class="mb-4">
        <%= image_tag identification.image,
            class: "img-fluid rounded",
            style: "max-height: 400px; object-fit: contain;" %>
      </div>
    <% end %>

    <style>
      /* Make the jellyfish float up and down */
      .floating-jelly {
        width: 70px;
        height: auto;
        position: relative;
        z-index: 2;
        animation: float 3s ease-in-out infinite;
      }

      @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-15px); }
      }

      /* Create a sonar/radar ping effect behind the jellyfish */
      .sonar-ping {
        width: 40px;
        height: 40px;
        background: #0dcaf0; /* Bootstrap Info color */
        border-radius: 50%;
        position: absolute;
        top: 40%;
        left: 50%;
        z-index: 1;
        animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
      }

      @keyframes ping {
        0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0.8; }
        100% { transform: translate(-50%, -50%) scale(3); opacity: 0; }
      }
    </style>

    <!-- The Animation Container -->
    <div class="position-relative d-inline-block mb-3 mt-2" style="height: 100px; width: 100px;">

      <!-- The Sonar Ping -->
      <div class="sonar-ping"></div>

      <!-- The SVG Jellyfish -->
      <svg class="floating-jelly" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Jellyfish Dome -->
        <path d="M 20 50 C 20 10, 80 10, 80 50 C 80 55, 20 55, 20 50 Z" fill="#6f42c1" opacity="0.9"/>
        <!-- Tentacles -->
        <path d="M 35 50 Q 30 75 40 95" stroke="#6f42c1" stroke-width="4" stroke-linecap="round" fill="none"/>
        <path d="M 50 50 Q 55 75 45 95" stroke="#6f42c1" stroke-width="4" stroke-linecap="round" fill="none"/>
        <path d="M 65 50 Q 70 75 60 95" stroke="#6f42c1" stroke-width="4" stroke-linecap="round" fill="none"/>
        <!-- Eyes -->
        <circle cx="40" cy="40" r="3" fill="white"/>
        <circle cx="60" cy="40" r="3" fill="white"/>
        <!-- Cute Smile -->
        <path d="M 46 45 Q 50 48 54 45" stroke="white" stroke-width="2" stroke-linecap="round" fill="none"/>
      </svg>

    </div>

    <h5 class="text-primary mt-2">
      Identifying your species...
    </h5>

    <small class="text-muted">
      Identifying species and fetching deep-sea facts. This can take a little while.
    </small>

  </div>
</div>
