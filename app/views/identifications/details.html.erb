<%= turbo_frame_tag "identification-content" do %>

  <div class="species-details-page">

    <div class="mb-4">
      <%# <button type="button"
              class="btn btn-outline-secondary"
              onclick="history.back()">
        ← Back to possible matches
      </button> %>
      <%= link_to "← Back to possible matches",
      identification_path(
        identification_id: @identification.id
      ),
      class: "btn btn-outline-secondary",
      data: {
        turbo_frame: "identification-content",
        turbo_action: "advance"
      } %>
    </div>

    <%= render "identifications/species_details",
          details: @details,
          identification_id: @identification_id,
          dive_id: @dive_id %>

  </div>

<% end %>
