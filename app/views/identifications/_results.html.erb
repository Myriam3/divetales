<div id="identification-results" data-controller="results">
  <% if identification&.image&.attached? %>
    <details class="mb-4 bg-light rounded-3 p-2 border">
      <summary class="fw-bold dive-text" style="cursor: pointer;">
        <i class="bi bi-camera"></i> View original photo
      </summary>

      <div class="mt-3 text-center">
        <%= image_tag identification.image,
              class: "img-fluid shadow-sm border",
              style: "max-height: 200px; object-fit: contain;" %>
      </div>
    </details>
  <% end %>


  <div data-results-target="matchesContainer">
    <% if results.present? && results.any? %>
      <h2 class="mb-4 d-flex align-items-center gap-2">
        <%= render "shared/icon", icon_name: "binary-tree", icon_size: 28 %> Possible Matches
      </h2>

      <!-- Tab Headers -->
      <div class="nav nav-tabs mb-4">
        <% results.each_with_index do |result, index| %>
          <button type="button"
                  data-results-target="tab"
                  data-action="click->results#show"
                  class="nav-link <%= 'active' if index == 0 %> d-flex align-items-center gap-2">

            <%= render "shared/icon", icon_name: "fish", icon_size: 18 %>
            <span class="dive-text">
              <%= result[:common_name].presence || result[:scientific_name] %>
            </span>

            <span class="ms-2 badge bg-dive-navy">
              <%= result[:confidence] %>%
            </span>
          </button>
        <% end %>
      </div>

      <!-- Tab Contents -->
      <div>
        <% results.each_with_index do |result, index| %>
          <div data-results-target="content"
              class="<%= 'd-none' unless index == 0 %>">

            <%= render "identifications/result_card",
                        result: result,
                        dive: @dive,
                        identification: @identification %>

          </div>
        <% end %>
      </div>

    <% end %>
  </div>

  <div class="my-5 pt-4 border-top text-center">
    <p class="dive-text d-flex align-items-center justify-content-center gap-2">
      <%= render "shared/icon", icon_name: "photo-question" %> Not seeing the right match?
    </p>
    <p class="small dive-muted mb-3">
      The Identification sometimes needs a little help. Provide a bit more context to narrow it down!
    </p>

    <button class="btn-dive-accent btn btn-dive-accent:hover d-inline-flex align-items-center gap-2"
            type="button"
            data-action="click->results#toggleForm">
      <%= render "shared/icon", icon_name: "pencil", icon_size: 18 %> Add more context & try again
    </button>

    <div class="d-none mt-4 text-start" data-results-target="refineForm">
      <div class="card card-body bg-light">
        <%= render "identifications/form" %>
      </div>
    </div>
  </div>

</div>
