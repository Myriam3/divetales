<div id="identification-results" data-controller="results">
  <% if identification&.image&.attached? %>
    <div class="mb-4">
      <h5>Your photo</h5>

      <%= image_tag identification.image,
            class: "img-fluid rounded",
            style: "max-height: 400px; object-fit: contain;" %>
    </div>
  <% end %>

  <% if results.present? && results.any? %>
    <h2 class="mb-4">Possible Matches</h2>

    <!-- Tab Headers -->
    <div class="nav nav-tabs mb-4">
      <% results.each_with_index do |result, index| %>
        <button type="button"
                data-results-target="tab"
                data-action="click->results#show"
                class="nav-link <%= 'active' if index == 0 %>">
          <%= result[:common_name].presence || result[:scientific_name] %>

          <span class="ms-2 badge bg-secondary">
            <%= result[:confidence] %>%
          </span>
        </button>
      <% end %>
    </div>

    <!-- Tab Contents -->
    <div>
      <% results.each_with_index do |result, index| %>
        <div data-results-target="content"
            class="<%= 'd-none' unless index == 0 %>">

          <%= render "identifications/result_card",
                      result: result,
                      dive: @dive,
                      identification: @identification %>

        </div>
      <% end %>
    </div>

  <% end %>

  <div class="mt-5 pt-4 border-top text-center">
    <h5 class="text-muted">Not seeing the right match?</h5>
    <p class="small text-muted mb-3">
      The Identification sometimes needs a little help. Provide a bit more context to narrow it down!
    </p>

    <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#refine-search-form">
      Add more context & try again
    </button>

    <div class="collapse mt-4 text-start" id="refine-search-form">
      <div class="card card-body bg-light">
        <%= render "identifications/form" %>
      </div>
    </div>
  </div>

</div>
