<% is_pending = @identification&.status == "pending" %>
<% target_dive = @dive || @picture&.dive %>
<!-- 1. Attach the polling controller WITH the explicit URL -->
<div
  <% if is_pending %>
    data-controller="identification-polling"
    data-identification-polling-interval-value="2000"
    data-identification-polling-url-value="<%= identification_path(identification_id: @identification.id, dive_id: @dive&.id, picture_id: @picture&.id) %>"
  <% end %>
>
  <%= simple_form_for (@identification || :identification), as: :identification, url: identification_path, method: :post,
      data: { controller: "upload-ui", action: "submit->upload-ui#showLoading" } do |f| %>

    <div data-upload-ui-target="formContent" class="<%= 'd-none' if is_pending %>">
      <div class="<%= 'd-none' if @identification&.persisted? %>">
        <% if @picture.present? && @picture.photo.attached? %>
          <div class="mb-4 text-center">
            <%= cl_image_tag @picture.photo.key,
                  class: "img-fluid rounded-4 shadow-sm border",
                  style: "max-height: 400px; width: 100%; object-fit: contain; background-color: #f8f9fa;",
                  data: { upload_ui_target: "sourceImage" } %>
          </div>

        <% else %>

          <div data-controller="image-preview" class="mb-4">
            <div class="row g-2">
              <!-- 1. Upload from Gallery -->
              <div class="col-6">
                <label for="identification_upload" class="btn btn-light border shadow-sm w-100 p-2 d-flex flex-column align-items-center justify-content-center gap-1 rounded-4" style="height: 85px; cursor: pointer;">
                  <div class="text-primary">
                    <%= render "shared/icon", icon_name: "photo-spark", icon_size: 28 %>
                  </div>
                  <span class="fw-bold text-dark small">Upload</span>
                </label>

                <!-- The Hidden Input -->
                <div class="d-none">
                  <%= f.input :upload,
                        as: :file,
                        label: false,
                        input_html: {
                          id: "identification_upload",
                          accept: "image/*, .orf, .ORF",
                          data: { action: "change->image-preview#preview" }
                        } %>
                </div>
              </div>

              <!-- 2. Take a Photo -->
              <div class="col-6">
                <label for="identification_camera" class="btn btn-light border shadow-sm w-100 p-2 d-flex flex-column align-items-center justify-content-center gap-1 rounded-4" style="height: 85px; cursor: pointer;">
                  <div class="text-primary">
                    <%= render "shared/icon", icon_name: "camera-spark", icon_size: 28 %>
                  </div>
                  <span class="fw-bold text-dark small">Camera</span>
                </label>

                <!-- The Hidden Input -->
                <div class="d-none">
                  <%= f.input :camera,
                        as: :file,
                        label: false,
                        input_html: {
                          id: "identification_camera",
                          capture: "environment",
                          accept: "image/*, .orf, .ORF",
                          data: { action: "change->image-preview#preview" }
                        } %>
                </div>
              </div>
            </div>

            <!-- Single, Centered Full-Width Image Preview -->
            <div data-image-preview-target="container" class="mt-4 d-none text-center w-100">
              <img data-image-preview-target="image"
                  data-upload-ui-target="sourceImage"
                  class="img-fluid rounded-4 shadow-sm border"
                  style="max-height: 400px; width: 100%; object-fit: contain; background-color: #f8f9fa;"
                  alt="Selected image preview">
            </div>

          </div>
        <% end %>
      </div>

      <%= hidden_field_tag :dive_id, @dive&.id %>

      <% if @picture.present? %>
        <%= hidden_field_tag :picture_id, @picture.id %>
      <% end %>

      <% if @identification&.image&.attached? %>
        <%= hidden_field_tag :existing_image_signed_id, @identification.image.signed_id %>

        <div class="alert alert-info py-2 small mb-4 d-flex align-items-center gap-2">
          <%= render "shared/icon", icon_name: "photo-check" %>
          <span>We'll reuse your uploaded photo. Just add your extra details below!</span>
        </div>
      <% end %>

      <div data-controller="identification-form">
        <div class="identification-section">
          <button type="button" class="btn btn-light w-100 text-start d-flex justify-content-between align-items-center p-3 border shadow-sm" data-action="click->identification-form#toggle" data-identification-form-target="question">
            <div class="d-flex align-items-center gap-3">
              <div class="text-primary d-flex">
                <%= render "shared/icon", icon_name: "fish", icon_size: 24 %>
              </div>
              <div>
                <div class="fw-bold text-dark">What did you see?</div>
                <div class="small text-muted fw-normal mt-1">color, size, shape, behavior, etc.</div>
              </div>
            </div>
            <div class="text-muted fs-4 lh-1">+</div>
          </button>

          <div class="identification-content d-none" data-identification-form-target="content">
            <%= f.input :color,
                  as: :text,
                  label: "<span class='dive-text d-flex align-items-center gap-2'>#{render 'shared/icon', icon_name: 'palette'} Color & Pattern</span>".html_safe,
                  placeholder: "e.g. blue body with yellow stripes",
                  required: false %>

            <%= f.input :size,
                  as: :text,
                  label: "<span class='d-flex align-items-center gap-2'>#{render 'shared/icon', icon_name: 'ruler'} Approximate size</span>".html_safe,
                  placeholder: "e.g. about 10 cm",
                  required: false %>

            <%= f.input :shape,
                  as: :text,
                  label: "<span class='d-flex align-items-center gap-2'>#{render 'shared/icon', icon_name: 'category'} Shape & Features</span>".html_safe,
                  placeholder: "e.g. long body, pointed nose, large eyes",
                  required: false %>

            <%= f.input :behavior,
                  as: :text,
                  label: "<span class='d-flex align-items-center gap-2'>#{render 'shared/icon', icon_name: 'activity'} Behavior</span>".html_safe,
                  placeholder: "e.g. hiding under rocks, swimming in a group",
                  required: false %>
          </div>
        </div>

        <div class="identification-section">
          <button type="button" class="btn btn-light w-100 text-start d-flex justify-content-between align-items-center p-3 border shadow-sm" data-action="click->identification-form#toggle" data-identification-form-target="question">
            <div class="d-flex align-items-center gap-3">
              <div class="text-primary d-flex">
                <%= render "shared/icon", icon_name: "world-pin", icon_size: 24 %>
              </div>
              <div>
                <div class="fw-bold text-dark">Where and when did you see it?</div>
                <div class="small text-muted fw-normal mt-1">location, dive site, date, depth, etc.</div>
              </div>
            </div>
            <div class="text-muted fs-4 lh-1">+</div>
          </button>

          <div class="identification-content d-none" data-identification-form-target="content">
            <%= f.input :location,
                  as: :text,
                  label: "<span class='d-flex align-items-center gap-2'>#{render 'shared/icon', icon_name: 'world-pin'} Location</span>".html_safe,
                  placeholder: "e.g. Komodo National Park",
                  input_html: { value: @dive&.location&.name },
                  required: false %>
            <%= f.input :dive_site,
              as: :text,
              label: "#{render 'shared/icon', icon_name: 'anchor'} Dive site".html_safe,
              placeholder: "e.g. shotgun",
              input_html: { value: @dive&.dive_site_name },
              required: false %>
            <%= f.input :date,
              as: :text,
              label: "#{render 'shared/icon', icon_name: 'calendar'} Date".html_safe,
              placeholder: "e.g. 2025-10-01",
              input_html: { value: @dive&.date },
              required: false %>
            <%= f.input :depth,
              as: :text,
              label: "#{render 'shared/icon', icon_name: 'arrow-bar-to-down'} Depth".html_safe,
              placeholder: "e.g. around 15m",
              required: false %>
            <%= f.input :habitat,
                  as: :text,
                  label: "<span class='d-flex align-items-center gap-2'>#{render 'shared/icon', icon_name: 'leaf'} Habitat</span>".html_safe,
                  placeholder: "e.g. fan coral",
                  required: false %>
          </div>
        </div>

        <div class="identification-section">
          <button type="button" class="btn btn-light w-100 text-start d-flex justify-content-between align-items-center p-3 border shadow-sm" data-action="click->identification-form#toggle" data-identification-form-target="question">
            <div class="d-flex align-items-center gap-3">
              <div class="text-primary d-flex">
                <%= render "shared/icon", icon_name: "scuba-diving", icon_size: 24 %>
              </div>
              <div>
                <div class="fw-bold text-dark">What else would you like to add?</div>
                <div class="small text-muted fw-normal mt-1">Anything else that might help identify it...</div>
              </div>
            </div>
            <div class="text-muted fs-4 lh-1">+</div>
          </button>

          <div class="identification-content d-none" data-identification-form-target="content">
            <%= f.input :additional_info,
                  as: :text,
                  label: "<span class='d-flex align-items-center gap-2'>#{render 'shared/icon', icon_name: 'pencil'} Anything else...</span>".html_safe,
                  input_html: {
                    rows: 5,
                    value: @dive&.dive_types&.any? ? "Dive type: #{@dive.dive_types.join(", ")}" : nil
                  },
                  placeholder: "Anything else that might help identify it...",
                  required: false %>
          </div>
        </div>
      </div>

      <%= f.button :button, class: "btn-dive-primary btn btn-secondary mt-5 d-flex align-items-center justify-content-center gap-2 w-100" do %>
        <%= render "shared/icon", icon_name: "photo-spark" %> Identify
      <% end %>
    </div>

    <!-- 2. The Loading UI with the Server-Side Image Check -->
   <div id="jellyfish-loading-ui"
         data-turbo-permanent="true"
         data-upload-ui-target="jellyfishUI"
         class="bubble-background <%= is_pending ? '' : 'd-none' %>">
      <div class="bubble-container">
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
        <div class="bubble"></div>
      </div>

      <div class="mb-4 text-center">
        <% if is_pending && @identification&.image&.attached? %>
          <!-- Server-side loaded image (for the redirect) -->
          <%= image_tag @identification.image.variant(resize_to_limit: [800, 800]),
                class: "img-fluid rounded shadow-sm",
                style: "max-height: 400px; object-fit: contain;" %>
        <% else %>
          <!-- Client-side instant preview image (for the local JS click) -->
          <img data-upload-ui-target="destinationImage"
               class="img-fluid rounded shadow-sm"
               style="max-height: 400px; object-fit: contain;">
        <% end %>
      </div>

      <%= render "shared/loading_screen",
            animation: "jellyfish",
            title: is_pending ? "Identifying your species..." : "Uploading & Identifying...",
            message: "Fetching deep-sea facts. This can take a little while." %>

    </div>
  <% end %>
</div>
