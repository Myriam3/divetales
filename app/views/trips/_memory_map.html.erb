<%
  map_dives = dives.map do |d|
    {
      id: d.id,
      lat: d.latitude,
      long: d.longitude,
      name: d.dive_site_name || d.location.name,
      number: d.dive_number,
      date: d.date,
      time: d.start_time ? d.start_time.strftime("%HH:%M") : nil,
      location_id: d.location.id,
    }
  end
%>

  <div data-controller="map"
        data-map-trip-id-value="<%= trip.id %>"
        data-map-api-url-value="<%= api_mapbox_path %>"
        data-map-dive-url-value ="<%= memory_dive_trip_path %>"
        data-map-dives-value ="<%=  map_dives.to_json %>"
  >

    <div class="container">
      <% if itinerary.any? %>
        <div data-controller="itinerary">
          <% render "memory_itinerary", itinerary: itinerary, countries_count: stats[:countries_count] %>
        </div>
      <% end %>
    </div>

    <div class="container">
      <div data-map-target="mapContainer" style="visibility: hidden; height: 0; oveflow: hidden;">
        <div data-map-target="mapCanvas"
            style="height: 400px; width: 100%; border-radius: 8px;">
        </div>
      </div>
    </div>

    <div id="memory-dive-container"></div>
    <%# render "trips/memory_dive", dive: @dives.find_by(dive_number: 184) %>
  </div>
