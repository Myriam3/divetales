<% content_for :title, "#{@trip.title} | DiveTales" %>

<section class="trip-show">
  <%= link_to trips_path, class: "trip-back-link" do %>
    <%= render "shared/icon", icon_name: "arrow-left" %>
    Back to trips
  <% end %>

  <div class="trip-show__header dive-card">
    <div class="trip-show__details">
      <h1><%= @trip.title %></h1>

      <p>
        <%= render "shared/icon", icon_name: "calendar-week" %>
        <%= @trip.start_date.strftime("%d %B %Y") %> -
        <%= @trip.end_date.strftime("%d %B %Y") %>
      </p>

      <% if @trip.info.present? %>
        <p><%= @trip.info %></p>
      <% end %>

      <% if @trip.countries.any? %>
        <p>
          <strong>Countries:</strong>
          <% @trip.countries.each do |country| %>
            <span class="trip-country">
              <%= icon country.code.downcase, library: "flags", width: 20, height: 20 %>
              <%= country.name %>
            </span>
          <% end %>
        </p>
      <% end %>
    </div>

    <div class="trip-show__actions">
      <%= link_to new_trip_dive_path(@trip), class: "btn-dive btn-dive-accent" do %>
        <%= render "shared/icon", icon_name: "scuba-mask", icon_size: 24 %>
        Add a new dive
      <% end %>

      <%= link_to edit_trip_path(@trip), class: "btn-dive btn-dive-secondary" do %>
        <%= render "shared/icon", icon_name: "edit" %>
        Edit trip
      <% end %>

      <%= link_to memory_trip_path(@trip), class: "btn-dive btn-dive-secondary" do %>
        <%= render "shared/icon", icon_name: "fish" %>
        Memory map
      <% end %>
    </div>
  </div>

  <div class="trip-dives-heading">
    <h2>
      <%= render "shared/icon", icon_name: "scuba-mask", icon_size: 40 %>
      Dives
    </h2>
    <span><%= pluralize(@dives.count, "dive") %></span>
  </div>

  <% if @dives.any? %>
    <div class="trip-dives-grid">
      <% @dives.each do |dive| %>
        <div class="trip-dive-card-wrapper">
          <%= link_to trip_dive_path(@trip, dive), class: "trip-dive-card-link" do %>
            <article class="trip-dive-card">
              <% first_picture = dive.pictures.order(:created_at).first %>
                <% if dive.cover_photo.attached? %>
                  <%= image_tag dive.cover_photo, alt: dive.dive_site_name, class: "trip-dive-card__image" %>
                <% elsif first_picture&.photo&.attached? %>
                  <%= image_tag first_picture.photo, alt: dive.dive_site_name, class: "trip-dive-card__image" %>
                <% else %>
                  <%= image_tag "dive-default.png", alt: "Underwater reef", class: "trip-dive-card__image" %>
                <% end %>

              <div class="trip-dive-card__body">
                <h3><%= dive.display_name_html %></h3>

                <p>
                  <%= render "shared/icon", icon_name: "calendar" %>
                  <%= dive.date.strftime("%d %B %Y") %>
                </p>

                <p>
                  <%= render "shared/icon", icon_name: "world-pin" %>
                  <%= dive.location.name %>
                </p>

                <% if dive.max_depth.present? %>
                  <p>
                    <%= render "shared/icon", icon_name: "arrow-bar-to-down" %>
                    Maximum depth:
                    <%= number_with_precision(dive.max_depth, precision: 1, strip_insignificant_zeros: true) %>m
                  </p>
                <% end %>

                <% if dive.duration.present? %>
                  <p>
                    <%= render "shared/icon", icon_name: "clock" %>
                    Duration: <%= dive.duration %> minutes
                  </p>
                <% end %>

                <span class="btn-dive btn-dive-primary">View dive</span>
              </div>
            </article>
          <% end %>

          <%= form_with model: dive, url: update_cover_photo_dive_path(dive), method: :patch, html: { class: "cover-photo-form", multipart: true } do |form| %>
            <label for="dive_cover_photo_<%= dive.id %>" class="cover-photo-button">
              <%= render "shared/icon", icon_name: "camera", icon_size: 16 %>
              Edit
            </label>

            <%= form.file_field :cover_photo, id: "dive_cover_photo_#{dive.id}", accept: "image/png,image/jpeg,image/webp", class: "cover-photo-input", onchange: "this.form.requestSubmit()" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="trips-empty">
      <h3>No dives yet</h3>
      <p>Your dives for this trip will appear here.</p>
      <%= link_to "Add your first dive", new_trip_dive_path(@trip), class: "btn-dive btn-dive-accent" %>
    </div>
  <% end %>

  <div class="trip-delete">
    <%= link_to trip_path(@trip), class: "btn-dive btn-dive-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure? This will also delete the dives and pictures." } do %>
      <%= render "shared/icon", icon_name: "trash", icon_size: 24 %>
      Delete trip
    <% end %>
  </div>
</section>
