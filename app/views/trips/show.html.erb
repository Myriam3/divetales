<% content_for :title, "#{@trip.title} | DiveTales" %>

<section class="trip-show mt-5">
  <%= link_to trips_path do %>
    <%= render "shared/icon", icon_name: "arrow-left" %>
    Back to trips
  <% end %>

  <h1 class="mt-5 mb-5"><%= @trip.title %></h1>

  <p class="mt-3 text-center">
    <%= link_to new_trip_dive_path(@trip), class: "btn btn-secondary" do %>
    <%= render "shared/icon", icon_name: "scuba-mask" %>
      Add a new dive
    <% end %>
  </p>

  <p class="mt-5">
    <%= render "shared/icon", icon_name: "calendar-week", label: "Date: " %>
    <%= @trip.start_date.strftime("%d %B %Y") %>
    -
    <%= @trip.end_date.strftime("%d %B %Y") %>
  </p>

  <% if @trip.info.present? %>
    <p><%= @trip.info %></p>
  <% end %>

  <% if @trip.countries.any? %>
    <p>
      <strong>Countries:</strong>
      <% @trip.countries.each do |country| %>
        <span>
          <%= icon country.code.downcase, library: "flags", width: 20, height: 20 %>
          <%= country.name %>
        </span>
      <% end %>
    </p>
  <% end %>

  <h2 class="mt-5 mb-5">
    <%= render "shared/icon", icon_name: "scuba-mask", icon_size: 40 %>
    Dives
  </h2>

  <% if @dives.any? %>
    <ul class="list-unstyled">
    <% @dives.each_with_index do |dive, index| %>
      <li><%= render "shared/dive_card", dive: dive, number: @dives.length - index, heading_level: 3 %></li>
    <% end %>
    </ul>
  <% else %>
    <p>No dives have been added yet.</p>
  <% end %>
</section>
