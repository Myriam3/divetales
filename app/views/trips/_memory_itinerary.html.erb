<div class="itinerary">
  <ol class="itinerary__list list-unstyled">
  <% itinerary.each do |item| %>
      <li class="itinerary__item"
          role="button"
          tabindex="0"
          data-map-target="itinaryBtn"
          data-location="<%= item[:location].id %>">
        <div class="itinerary__inner">
          <h3 class="itinerary__title">
            <% if countries_count.positive? %>
              <span title="<%= item[:location].country.name %>">
                <%= icon item[:location].country.code.downcase, library: "flags", width: 20, height: 20 %>
                <span class="visually-hidden"><%= item[:location].country.name %></span>
              </span>
            <% end %>
            <%= item[:location].name %>
          </h3>
          <p class="itinerary__date" style="font-size: 0.8rem;">
            <%= render "shared/icon", icon_name: "calendar-week", icon_size: 16 %>
            <%= l(item[:start_date]) %>
            <% if item[:end_date] != item[:start_date] %>
              → <%= l(item[:end_date]) %>
            <% end %>
          </p>
          <% if item[:dives_count].positive? %>
            <p class="itinerary__info">
              <%= render "shared/icon", icon_name: "scuba-mask", icon_size: 18 %>
              <%= pluralize(item[:dives_count], "dive") %>
            </p>
            <% if item[:pictures_count].positive? %>
              <p class="itinerary__info">
                <%= render "shared/icon", icon_name: "camera-spark", icon_size: 18 %>
                <%= pluralize(item[:pictures_count], "picture") %>
              </p>
            <% end %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ol>
</div>
