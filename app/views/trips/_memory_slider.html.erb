<%
  # Slider
  max = local_assigns[:max] || 20
  label = local_assigns[:label] || "Pictures"
  focus = local_assigns[:focus] || "center"
  type = local_assigns[:type] || "loop"
  rewind = local_assigns[:type] || true

  # Lightbox
  dive = pictures.first.dive
  lightbox_params =
    if local_assigns[:context] == "trip"
      { trip_id: dive.trip.id }
    elsif local_assigns[:context] == "dive"
      { dive_id: dive.id }
    elsif local_assigns[:context] == "location"
      { location_id: dive.location.id }
    else
      {}
    end
%>

<style>
  .memory-slider .splide__slide {
    transition: width;
    width: 250px;
    transition: width 0.3s;
  }

  .memory-slider .splide__slide .pic-slide {
    width: 100%;
    overflow: hidden;
    aspect-ratio: 3/2;
    transition: width 0.3s;
    border-radius: 4px;
  }

  .memory-slider .splide__slide .pic-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .memory-slider .splide__slide.is-selected {
    width: 360px;
  }
</style>

<div class="memory-slider"
    data-controller="slider"
    data-action="depth-chart:picture-selected@window->slider#selectPicture"
    data-slider-type-value="slide"
    data-slider-rewind-value="false"
    data-slider-auto-width-value="true"
    data-slider-arrows-value="false"
    data-slider-focus-value="0"
    data-slider-padding-left-value="calc((100vw - 1200px) / 2)"
    class="mt-3"
    style="min-height: 250px;"
>
  <div class="splide"
      aria-label="<%= label %>"
      data-slider-target="sliderContainer"
  >
    <div class="splide__track">
      <ol class="splide__list list-unstyled">
        <% pictures.first(max).each do |picture| %>
          <li class="splide__slide" data-time="<%= picture.date_time&.iso8601 %>"  data-id="<%= picture.id %>">
            <%
              lightbox_params = lightbox_params.merge(picture_id: picture.id)
            %>
            <%= link_to lightbox_pictures_path(lightbox_params),
                  data: {
                    turbo_stream: true,
                    action: "click->lightbox#open"
                  } do %>
              <%= render "shared/picture_slide", picture: picture, show_info: false %>
            <% end %>
            <span><%= picture.date_time&.strftime('%Y-%m-%d %H:%M') %></span>
\          </li>
        <% end %>
      </ol>
    </div>
  </div>
</div>
