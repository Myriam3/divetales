<% content_for :title, "Trips | DiveTales" %>

<section class="trips-page">
  <div class="trips-hero">
    <h1>DiveTales</h1>
    <h2>Every dive has a story.</h2>
    <p>Keep track of your dives and underwater memories.</p>
  </div>

  <div class="trips-content">
    <div class="trips-heading">
      <h2>Previous trips</h2>
      <span><%= pluralize(@trips.count, "trip") %></span>
      <%= link_to "Create a trip", new_trip_path, class: "btn-dive btn-dive-accent" %>
    </div>

    <% if @trips.any? %>
      <div class="trips-grid">
        <% @trips.each do |trip| %>
          <%= link_to trip_path(trip), class: "trip-card-link" do %>
            <article class="trip-card">
              <%= image_tag "trip-waves.png", alt: "Blue ocean waves", class: "trip-card__image" %>

              <div class="trip-card__body">
                <h3><%= render "shared/icon", icon_name: "luggage", icon_size: 30 %> <%= trip.title %></h3>

                <p>
                  <%= trip.start_date.strftime("%d %B %Y") %> -
                  <%= trip.end_date.strftime("%d %B %Y") %>
                </p>

                <% if trip.info.present? %>
                  <p><%= trip.info %></p>
                <% end %>

                <span class="btn-dive btn-dive-primary">View trip</span>
              </div>
            </article>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="trips-empty">
        <h3>No trips yet</h3>
        <p>Your saved trips will appear here.</p>
        <%= link_to "Create your first trip", new_trip_path, class: "btn-dive btn-dive-accent" %>
      </div>
    <% end %>
  </div>
</section>
