<div id="memory-dive-container" class="memory-dive">
  <div class="memory-dive__inner">
    <% unless dive.dive_site_name.blank? %>
      <h3 class="memory-dive__title">
        <%= render "shared/icon", icon_name: "anchor", icon_size: 28 %>
        <%= dive.dive_site_name %>
        <small>
          <%= dive.latitude %>, <%= dive.longitude %>
        </small>
      </h3>
    <% end %>

    <div data-map-target="itineraryLocationWrapper" class="memory-dive__location">
      <div class="container">
        <div data-map-target="itineraryLocation"></div>
      </div>
    </div>


    <div class="memory-dive__pictures">
      <p class="memory-dive__pictures-count">
        <%= render "shared/icon", icon_name: "camera-spark" %>
        <%= pluralize(dive.pictures.count, "pictures") %>
      </p>
      <% if dive.pictures.any? %>
        <% dive_pictures = dive.pictures.sort_by do |picture|
            [
              picture.date_time.nil? ? 1 : 0,
              picture.date_time || dive.date.to_time
            ]
            end
        %>
        <%= render "memory_slider",
            pictures: dive_pictures,
            max: [dive_pictures.length, 16].min,
            label: "Dive pictures",
            context: "dive",
            page: 5
        %>
      <% end %>
    </div>

    <div class="memory-dive__grid">
      <div class="memory-dive__info">
        <h4>
          <%= render "shared/icon", icon_name: "scuba-mask", icon_size: 36 %>
          <%= dive.display_name_html %>
        </h4>
        <%= render "shared/dive_types", dive: dive %>
        <p>
          <%= render "shared/icon", icon_name: "calendar", label: "Date: " %>
          <%= dive.date.strftime("%d %B %Y") %>
        </p>
        <p>
          <% unless dive.start_time.blank? %>
            <%= render "shared/icon", icon_name: "ripple-down" %>
            Start: <%= dive.start_time.strftime("%H:%M") %>
          <% end %>
        </p>

        <%= render "/shared/dive_info_log",
            dive: dive,
            display_time: false
        %>
        <p>
          <%= link_to dive_path(dive, anchor: "log"), class: "btn-dive btn-dive-secondary" do %>
            <%= render "shared/icon", icon_name: "device-watch-stats" %>
            Ful dive log
          <% end %>
        </p>
      </div>

      <% if dive.depth_over_time.present? %>
        <div class="memory-dive__depth">
          <%= render "/shared/depth_profile",
              dive: dive, display_info: false, display_pictures: true
          %>
        </div>
      <% end %>
    </div>
</div>
</div>
