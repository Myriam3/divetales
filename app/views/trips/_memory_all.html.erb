<section class="memory-pictures">
  <h2 class="memory-pictures__title">
    <%= render "shared/icon", icon_name: "camera-spark", icon_size: 40 %>
    Pictures from your trip
  </h2>

  <%= render "memory_slider", pictures: pictures, context: 'trip', max: 16, type: "loop" %>

  <% if pictures.length > 1  %>
    <p class="memory-pictures__btn">
      <%= link_to pictures_path(trip_id: @trip.id),
          class: "btn-dive btn-dive-accent", data: { turbo: false } do %>
          <%= render "shared/icon", icon_name: "library-photo", icon_size: 20 %>
          All trip pictures<small> (<%= pictures.length %>)</small>
      <% end %>
    </p>
  <% end %>
</section>

