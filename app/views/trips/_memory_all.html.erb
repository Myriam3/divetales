<section class="memory-section memory-gallery">
  <div class="memory-section-heading">
    <h2>
      <%= render "shared/icon", icon_name: "camera-spark", icon_size: 30 %>
      Pictures from your trip
    </h2>

    <% if pictures.length > 1 %>
      <%= link_to pictures_path, class: "btn-dive btn-dive-primary", data: { turbo: false } do %>
        <%= render "shared/icon", icon_name: "library-photo", icon_size: 20 %>
        All trip pictures (<%= pictures.length %>)
      <% end %>
    <% end %>
  </div>

  <%= render "memory_slider", pictures: pictures, context: "trip", max: 16 %>
</section>

<section class="memory-section">
  <h2>
    <%= render "shared/icon", icon_name: "fish", icon_size: 30 %>
    Encountered Marine life
  </h2>

  <%= #render "memory_species",
    #categories_by_class: @categories_by_class,
    #classification_pictures_stats: @classification_pictures_stats,
    #species_pictures_stats: @species_pictures_stats
  %>
</section>
