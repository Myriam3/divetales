<script>
    (() => {
        window.addEventListener('DOMContentLoaded', (e) => {
          console.log(e)
          const chartTimeCtx = document.getElementById('diveTimeChart')?.getContext('2d');
          const chartEntryCtx = document.getElementById('diveEntryChart')?.getContext('2d');

          if (chartTimeCtx) {
            const chartTime = new Chart(chartTimeCtx, {
              type: 'pie',
              data: {
                labels: ['Night', 'Morning', 'Afternoon'],
                datasets: [{
                  data: [<%= dives_by_time[:night] %>, <%= dives_by_time[:morning] %>, <%= dives_by_time[:afternoon] %>],
                  backgroundColor: ['#36A2EB', '#FF6384', '#FFCE56']
                }]
              }
            });
          }

          if (chartEntryCtx) {
            const chartEntry = new Chart(chartEntryCtx, {
              type: 'pie',
              data: {
                labels: ['Boat', 'Shore', 'Other'],
                datasets: [{
                  data: [<%= @dives_by_entry[:boat] %>, <%= @dives_by_entry[:shore] %>, <%= @dives_by_entry[:other] %>],
                  backgroundColor: ['#36A2EB', '#FF6384', '#FFCE56']
                }]
              }
            });
          }

        });
    })();
  </script>
