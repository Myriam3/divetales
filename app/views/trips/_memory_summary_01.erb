<% if local_assigns[:stats] && local_assigns[:stats].any? %>
  <div class="trip-summary">
    <ul class="trip-summary__list list-unstyled">
      <li>
        <%= render "shared/icon", icon_name: "scuba-mask", icon_size: 36 %>
        <div>
          <p class="trip-summary__title"><%= pluralize(@stats[:dives_count], "Dive") %></p>
          <p class="trip-summary__subtitle"><%= pluralize(@stats[:dive_days_count], "Diving day") %></p>
        </div>
      </li>
      <% if @stats[:total_duration].positive? %>
      <li>
        <%= render "shared/icon", icon_name: "chart-bubble", icon_size: 36 %>
        <div>
          <p class="trip-summary__title"><%= @stats[:total_duration] %>min</p>
          <p class="trip-summary__subtitle">Total underwater</p>
        </div>
      </li>
      <% end %>
      <% if @stats[:max_depth].present? %>
        <li>
          <%= render "shared/icon", icon_name: "arrow-bar-to-down", icon_size: 36 %>
          <div>
            <p class="trip-summary__title"><%= @stats[:max_depth].round %>m</p>
            <p class="trip-summary__subtitle">Deepest dive</p>
          </div>
        </li>
      <% end %>
      <% if @stats[:max_duration].positive? %>
        <li>
          <%= render "shared/icon", icon_name: "clock", icon_size: 36 %>
          <div>
            <p class="trip-summary__title"><%= @stats[:max_duration] %>min</p>
            <p class="trip-summary__subtitle">Longest dive</p>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

