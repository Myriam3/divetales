<% if @trip %>
  <div class="mt-5 mb-5">
    <%= link_to trip_path(@trip) do %>
      <%= render "shared/icon", icon_name: "arrow-left" %>
      Back to trip page
    <% end %>
  </div>


  <div>
    <h1 class="mt-5 mb-4 text-center">
      <%= render "shared/icon", icon_name: "album", icon_size: 42 %>
      <strong>Memories</strong><br>
      <%= @trip.title %>
    </h1>

    <div>
      <% if @trip.countries.any? %>
      <p class="text-center">
        <strong>Countries:</strong>
        <% @trip.countries.each do |country| %>
          <span>
            <%= icon country.code.downcase, library: "flags", width: 20, height: 20 %>
            <%= country.name %>
          </span>
        <% end %>
      </p>
      <% end %>

      <p class="text-center">
        <%= render "shared/icon", icon_name: "calendar-week", icon_size: 24 %>
        <%= @trip.start_date.strftime("%d %B %Y") %>
          -
        <%= @trip.end_date.strftime("%d %B %Y") %>
      </p>

      <% if @trip.info.present? %>
        <p class="text-center"><%= @trip.info %></p>
      <% end %>
    </div>
  </div>

  <div class="container">
    <%= #render "memory_summary",
        #stats: @stats,
        #dives_by_time: @dives_by_time,
        #dives_by_entry: @dives_by_entry
    %>
  </div>

  <section class="mb-5 container">
    <h2 class="mb-4" id="itinerary">
      <%= render "shared/icon", icon_name: "route", icon_size: 36 %>
      Itinerary
    </h2>

    <%= render 'memory_map',
        dives: @dives,
        trip: @trip,
        itinerary: @itinerary,
        stats: @stats
    %>
  </section>

  <section class="mb-5 container">
    <h2 class="mb-3">
      <%= render "shared/icon", icon_name: "fish", icon_size: 36 %>
      Encontered marine life
    </h2>

    <div
      data-controller="species-chart"
      data-species-chart-labels-value="<%= @classification_pictures_stats.keys.to_json %>"
      data-species-chart-data-value="<%= @classification_pictures_stats.values.to_json %>"
      data-species-chart-categories-value="<%= @categories_by_class.to_json %>"
      style="width: 300px;"
    >
      <canvas data-species-chart-target="canvas"></canvas>

      <div data-species-chart-target="details"></div>
    </div>

    <% @species_pictures_stats.each do |classification, species_stats| %>
      <h3><%= classification.humanize %></h3>
      <ul class="list-unstyled">
        <% species_stats.each do |species, picture_count| %>
          <li><%= species.name %> : <%= picture_count %> picture<%= "s" unless picture_count == 1 %></li>
        <% end %>
      </ul>
    <% end %>

  </section>
<% end %>
