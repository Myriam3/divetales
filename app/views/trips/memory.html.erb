<% if @trip %>
  <div class="mt-5 mb-5">
    <%= link_to trip_path(@trip) do %>
      <%= render "shared/icon", icon_name: "arrow-left" %>
      Back to trip page
    <% end %>
  </div>


  <div>
    <h1 class="mt-5 mb-4 text-center">
      <%= render "shared/icon", icon_name: "album", icon_size: 42 %>
      <strong>Memories</strong><br>
      <%= @trip.title %>
    </h1>

    <div>
      <% if @trip.countries.any? %>
      <p class="text-center">
        <strong>Countries:</strong>
        <% @trip.countries.each do |country| %>
          <span>
            <%= icon country.code.downcase, library: "flags", width: 20, height: 20 %>
            <%= country.name %>
          </span>
        <% end %>
      </p>
      <% end %>

      <p class="text-center">
        <%= render "shared/icon", icon_name: "calendar-week", icon_size: 24 %>
        <%= @trip.start_date.strftime("%d %B %Y") %>
          -
        <%= @trip.end_date.strftime("%d %B %Y") %>
      </p>

      <% if @trip.info.present? %>
        <p class="text-center"><%= @trip.info %></p>
      <% end %>
    </div>
  </div>


  <section class="mb-5">
    <h2>Summary</h2>
    <ul>
      <li><%= @stats[:dive_days_count] %> diving days</li>
      <li><%= @stats[:dives_count] %> dives</li>
      <% if @stats[:total_duration].positive? %>
        <li><%= @stats[:total_duration]%> min underwater</li>
      <% end %>
      <% if @stats[:max_depth].present? %>
        <li><%= @stats[:max_depth].round %> m deepest</li>
      <% end %>
      <% if @stats[:avg_temp].positive? %>
        <li><%= @stats[:avg_temp].round(1) %> °C average</li>
        <li><%= @stats[:pictures_count] %> pictures</li>
        <li><%= @stats[:species_count] %> species identified</li>
      <% end %>
    </ul>
  </section>

  <section class="mb-5">
    <h2 class="mb-3">Your dives</h2>

    <%
      map_dives = @dives.map do |d|
        {
          id: d.id,
          lat: d.latitude,
          long: d.longitude,
          name: d.dive_site_name || d.location.name,
          date: d.date,
          time: d.start_time ? d.start_time.strftime("%HH:%mm") : nil
        }
      end
    %>

    <div data-controller="map"
          data-map-trip-id-value="<%= @trip.id %>"
          data-map-api-url-value="<%= api_mapbox_path %>"
          data-map-dive-url-value ="<%= memory_dive_trip_path %>"
          data-map-dives-value="<%=  map_dives.to_json %>">

      <div data-map-target="mapContainer" style="visibility: hidden; height: 0; oveflow: hidden;"></div>
      <div data-map-target="mapCanvas"
          style="height: 500px; width: 100%; border-radius: 8px; margin-top: 20px;">
      </div>

      <div id="memory-dive-container"></div>
    </div>
  </section>

  <section class="mb-5">
    <h2 class="mb-3">
      <%= render "shared/icon", icon_name: "fish", icon_size: 36 %>
      Encontered marine life
    </h2>

    <% @species_pictures_stats.each do |classification, species_stats| %>
      <h3><%= classification.humanize %></h3>
      <ul class="list-unstyled">
        <% species_stats.each do |species, picture_count| %>
          <li><%= species.name %> : <%= picture_count %> picture<%= "s" unless picture_count == 1 %></li>
        <% end %>
      </ul>
    <% end %>

  <div
    data-controller="species-chart"
    data-species-chart-labels-value="<%= @classification_pictures_stats.keys.to_json %>"
    data-species-chart-data-value="<%= @classification_pictures_stats.values.to_json %>"
    data-species-chart-categories-value="<%= @categories_by_class.to_json %>"
  >
    <canvas data-species-chart-target="canvas"></canvas>

    <div data-species-chart-target="details"></div>
  </div>

  </section>

<% end %>
