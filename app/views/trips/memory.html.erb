<% content_for :title, "Memory Map | DiveTales" %>

<% if @trip %>
  <section class="memory-page">
    <div class="memory-hero">
      <div class="memory-content">
        <%= link_to trip_path(@trip), class: "btn-dive btn-dive-secondary memory-back" do %>
          <%= render "shared/icon", icon_name: "arrow-left" %>
          Back to trip
        <% end %>

        <p class="memory-eyebrow">
          <%= render "shared/icon", icon_name: "album", icon_size: 24 %>
          Memory Map
        </p>
        <h1><%= @trip.title %></h1>

        <% if @trip.countries.any? %>
          <p class="memory-countries">
            <% @trip.countries.each do |country| %>
              <span>
                <%= icon country.code.downcase, library: "flags", width: 20, height: 20 %>
                <%= country.name %>
              </span>
            <% end %>
          </p>
        <% end %>

        <p>
          <%= render "shared/icon", icon_name: "calendar-week", icon_size: 22 %>
          <%= @trip.start_date.strftime("%d %B %Y") %> -
          <%= @trip.end_date.strftime("%d %B %Y") %>
        </p>

        <% if @trip.info.present? %>
          <p class="memory-description"><%= @trip.info %></p>
        <% end %>
      </div>
    </div>

    <div class="memory-content" data-controller="lightbox">
      <section class="memory-section">
        <h2 id="itinerary">
          <%= render "shared/icon", icon_name: "route", icon_size: 30 %>
          Itinerary
        </h2>

        <%= render "memory_map",
          dives: @dives,
          trip: @trip,
          itinerary: @itinerary,
          stats: @stats %>
      </section>

      <% if @pictures.any? %>
        <%= render "memory_all", pictures: @pictures %>
      <% end %>

      <%= render "pictures/lightbox" %>
    </div>
  </section>
<% end %>
