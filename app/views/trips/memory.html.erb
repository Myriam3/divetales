<% if @trip %>
  <div class="mt-5 mb-5">
    <%= link_to trip_path(@trip) do %>
      <%= render "shared/icon", icon_name: "arrow-left" %>
      Back to trip page
    <% end %>
  </div>


  <div>
    <h1 class="mt-5 mb-4 text-center">
      <%= render "shared/icon", icon_name: "album", icon_size: 42 %>
      <strong>Memories</strong><br>
      <%= @trip.title %>
    </h1>

    <div>
      <% if @trip.countries.any? %>
      <p class="text-center">
        <strong>Countries:</strong>
        <% @trip.countries.each do |country| %>
          <span>
            <%= icon country.code.downcase, library: "flags", width: 20, height: 20 %>
            <%= country.name %>
          </span>
        <% end %>
      </p>
      <% end %>

      <p class="text-center">
        <%= render "shared/icon", icon_name: "calendar-week", icon_size: 24 %>
        <%= @trip.start_date.strftime("%d %B %Y") %>
          -
        <%= @trip.end_date.strftime("%d %B %Y") %>
      </p>

      <% if @trip.info.present? %>
        <p class="text-center"><%= @trip.info %></p>
      <% end %>
    </div>
  </div>

  <div class="container">
    <%= #render "memory_summary",
        #stats: @stats,
        #dives_by_time: @dives_by_time,
        #dives_by_entry: @dives_by_entry
    %>
  </div>

  <section class="mb-5">
    <div class="container">
      <h2 class="mb-4 mt-5 fw-bold" id="itinerary">
        <%= render "shared/icon", icon_name: "route", icon_size: 40 %>
        Itinerary
      </h2>
    </div>

    <%= render 'memory_map',
        dives: @dives,
        trip: @trip,
        itinerary: @itinerary,
        stats: @stats
    %>
  </section>

  <% if @pictures.any? %>
    <section class="mb-5">
      <h2 class="mb-5 fw-bold text-center">
        <%= render "shared/icon", icon_name: "camera-spark", icon_size: 40 %>
        Pictures from your trips
      </h2>

      <%= render "memory_slider", pictures: @pictures %>

      <% if @pictures.length > 1  %>
        <p class="mt-5 text-center">
          <%= link_to pictures_path,
              class: "btn btn-secondary" do %>
              <%= render "shared/icon", icon_name: "library-photo", icon_size: 20 %>
              All trip pictures<small> (<%= @pictures.length %>)</small>
            <% end %>
        </p>
      <% end %>
    </section>

    <section class="mb-5 mb-5 container">
      <h2 class="mb-3 fw-bold text-center">
        <%= render "shared/icon", icon_name: "fish", icon_size: 44 %>
        Encountered Marine life
      </h2>

      <%= #render "memory_species",
        #categories_by_class: @categories_by_class,
        #classification_pictures_stats: @classification_pictures_stats,
        #species_pictures_stats: @species_pictures_stats
      %>
    </section>
  <% end %>
<% end %>
